---
import Layout from './Layout.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: object | object[];
}
---

<Layout {...Astro.props} activePage="blog">
  <div class="bg-[#f8f7fc] min-h-screen pt-[68px]">
    <slot />
  </div>
  <Footer />
</Layout>
