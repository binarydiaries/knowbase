{
  "name": "knowbase",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:dashboard": "turbo run build --filter=dashboard",
    "build:landing": "turbo run build --filter=landing",
    "build:client": "turbo run build --filter=client",
    "build:embed": "turbo run build --filter=embed",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.2.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
