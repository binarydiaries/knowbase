---
import { getImage } from 'astro:assets';
import usecaseBgSrc from '../assets/images/usecase-bg.png';

const usecaseBg = await getImage({ src: usecaseBgSrc, format: 'webp', quality: 80 });

const useCases = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
    title: 'E-commerce & Retail',
    headline: 'Fewer support tickets. Happier customers.',
    desc: 'Shipping status, return policy, size guides, product questions — your agent handles tier-1 support automatically so your team focuses on the hard stuff.',
    href: '/use-cases/ecommerce',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
    title: 'SaaS & Tech Products',
    headline: 'Answer product questions without a CS call.',
    desc: 'Guide new users to their first "aha moment". Answer integration questions. Explain pricing. Your agent knows your docs better than most new hires.',
    href: '/use-cases/saas',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'Internal Teams',
    headline: 'New hire asks Slack. Gets the answer. Done.',
    desc: "Stop being the person everyone DMs for things that should be written down. Your agent knows your SOPs, processes, and company docs. Knowledge stops leaving when people do.",
    href: '/use-cases/internal-knowledge',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
    title: 'Coaches & Educators',
    headline: 'Your expertise. Available 24/7.',
    desc: 'Turn your course material, workbooks, or coaching notes into an agent your students can ask anything, anytime. Personalised answers at scale.',
    href: null,
  },
];
---
<section aria-labelledby="usecases-heading" class="px-6 pt-16">
  <div class="max-w-6xl mx-auto">
    <div
      class="relative rounded-3xl p-10 md:p-14 overflow-hidden bg-cover bg-center"
      style={`background-image: url(${usecaseBg.src})`}
    >
      <div class="absolute inset-0 bg-white/40 backdrop-blur-[2px]" aria-hidden="true"></div>

      <div class="relative z-10">
        <div class="inline-flex items-center gap-2 px-4 py-1 text-xs rounded-full bg-white/70 backdrop-blur text-[#301B69] mb-6" aria-hidden="true">
          ✦ WHO USES AGENVIK
        </div>

        <h2 id="usecases-heading" class="text-3xl md:text-4xl font-bold text-[#301B69] mb-3">
          Whatever your business. Wherever your customers are.
        </h2>

        <div class="grid md:grid-cols-2 gap-6 mt-10">
          {useCases.map((item) => (
            <div class="rounded-2xl bg-white/80 border border-[#301B69]/10 p-6">
              <div class="flex items-start gap-3 mb-3">
                <div class="mt-0.5 text-[#301B69] flex-shrink-0" aria-hidden="true" set:html={item.icon} />
                <div>
                  <p class="text-xs text-[#301B69]/50 uppercase tracking-widest mb-0.5">{item.title}</p>
                  <h3 class="font-semibold text-[#301B69]">{item.headline}</h3>
                </div>
              </div>
              <p class="text-sm text-[#301B69]/70 leading-relaxed mb-4">{item.desc}</p>
              {item.href && (
                <a href={item.href} class="text-sm text-[#301B69] font-medium hover:opacity-70 transition-opacity">
                  See how it works →
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
