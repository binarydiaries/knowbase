---
const base = import.meta.env.BASE_URL
---

<footer class="px-6 py-10 mt-16 border-t border-[#301B69]/10 bg-white/60">
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <div>
        <a href="https://agenvik.com" aria-label="Agenvik home">
          <img src={`${base}/TextLogo.svg`} alt="Agenvik" class="h-7 w-auto mb-3" />
        </a>
        <p class="text-sm text-[#301B69]/60 leading-relaxed max-w-xs">
          Build powerful AI agents from your knowledge. No coding required.
        </p>
      </div>

      <nav aria-label="Quick links">
        <h2 class="text-sm font-semibold text-[#301B69] mb-3">Quick Links</h2>
        <ul class="space-y-2 text-sm text-[#301B69]/70 list-none">
          <li><a href="https://agenvik.com" class="hover:text-[#301B69] transition">Home</a></li>
          <li><a href="https://agenvik.com/#features" class="hover:text-[#301B69] transition">Features</a></li>
          <li><a href="https://agenvik.com/#pricing" class="hover:text-[#301B69] transition">Pricing</a></li>
          <li><a href={base} class="hover:text-[#301B69] transition">Blog</a></li>
        </ul>
      </nav>

      <nav aria-label="Resources links">
        <h2 class="text-sm font-semibold text-[#301B69] mb-3">Resources</h2>
        <ul class="space-y-2 text-sm text-[#301B69]/70 list-none">
          <li><a href="https://agenvik.com/docs" class="hover:text-[#301B69] transition">Documentation</a></li>
          <li><a href="https://agenvik.com/docs/help-and-support/overview" class="hover:text-[#301B69] transition">Help & Support</a></li>
          <li><a href="https://agenvik.com/privacy-policy" class="hover:text-[#301B69] transition">Privacy Policy</a></li>
          <li><a href="https://agenvik.com/terms" class="hover:text-[#301B69] transition">Terms & Conditions</a></li>
        </ul>
      </nav>
    </div>

    <div class="border-t border-[#301B69]/10 pt-6">
      <p class="text-center text-sm text-[#301B69]/50">
        &copy; {new Date().getFullYear()} Agenvik. All rights reserved.
      </p>
    </div>
  </div>
</footer>
