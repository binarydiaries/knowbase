---
import { getImage } from 'astro:assets';
import pricingBgSrc from '../assets/images/pricing-bg.png';

const pricingBg = await getImage({ src: pricingBgSrc, format: 'webp', quality: 80 });
const apiBase = import.meta.env.PUBLIC_API_BASE || '';
const appURL = import.meta.env.PUBLIC_APP_URL || 'https://app.agenvik.com';
---
<section id="pricing" aria-labelledby="pricing-heading" class="px-6 pt-16">
  <div class="max-w-6xl mx-auto">
    <div
      class="relative rounded-3xl p-10 md:p-14 overflow-hidden bg-cover bg-center"
      style={`background-image: url(${pricingBg.src})`}
    >
      <div class="absolute inset-0 bg-white/50 backdrop-blur-[2px]" aria-hidden="true"></div>

      <div class="relative z-10">
        <div class="text-center mb-16">
          <div class="inline-flex px-4 py-1 text-xs rounded-full bg-white/70 text-[#301B69] mb-4" aria-hidden="true">
            ✦ Pricing
          </div>
          <h2 id="pricing-heading" class="text-3xl md:text-4xl font-bold text-[#301B69] mb-4">
            Simple, transparent pricing
            <br />
            that scales with you
          </h2>
          <p class="text-[#301B69]/70 max-w-2xl mx-auto text-sm md:text-base">
            Start for free and upgrade as your usage grows. No hidden fees,
            no complicated tiers—just clear limits and real value. Whether
            you're building a personal agent or scaling for an enterprise,
            Agenvik grows with you.
          </p>
        </div>

        <ul id="pricing-grid" class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 list-none">
          <!-- Skeleton cards shown while loading -->
          <li class="rounded-2xl bg-white/60 animate-pulse h-80"></li>
          <li class="rounded-2xl bg-white/60 animate-pulse h-80"></li>
          <li class="rounded-2xl bg-white/60 animate-pulse h-80"></li>
          <li class="rounded-2xl bg-white/60 animate-pulse h-80"></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ apiBase, appURL }}>
  async function loadPricing() {
    const grid = document.getElementById('pricing-grid');
    if (!grid) return;

    if (!apiBase) {
      grid.innerHTML = '<li class="col-span-4 text-center text-[#301B69]/60 py-8">Pricing information coming soon.</li>';
      return;
    }

    try {
      const res = await fetch(`${apiBase}/subscriptions/plans`);
      const data = await res.json();
      const plans = data.plans ?? [];

      if (plans.length === 0) {
        grid.innerHTML = '<li class="col-span-4 text-center text-[#301B69]/60 py-8">No plans available at this time.</li>';
        return;
      }

      grid.innerHTML = plans.map((plan) => {
        const isFree = plan.priceMonthlyPaise === 0;
        const cardClass = plan.highlight
          ? 'rounded-2xl p-6 border shadow-lg border-[#301B69]/20 bg-white transition'
          : 'rounded-2xl p-6 border shadow-sm border-[#301B69]/10 bg-white/80 transition';
        const btnClass = plan.highlight
          ? 'w-full p-2.5 rounded-xl text-sm transition bg-[#301B69] text-white shadow-md'
          : 'w-full p-2.5 rounded-xl text-sm transition bg-white border border-[#301B69]/20 text-[#301B69]';

        const featuresHTML = plan.features.map((f) => `
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#301B69] flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-sm text-[#301B69]/80">${f}</span>
          </li>
        `).join('');

        return `
          <li class="${cardClass}">
            <article aria-label="${plan.name} plan">
              <div class="mb-4 flex items-start justify-between">
                <h3 class="text-xl font-semibold text-[#301B69]">${plan.name}</h3>
                ${plan.highlight ? '<span class="inline-block mt-1 text-xs px-2 py-1 rounded-full bg-[#301B69]/10 text-[#301B69]">✦ Most Popular ✦</span>' : ''}
              </div>
              <div class="mb-6">
                <span class="text-3xl font-bold text-[#301B69]">${plan.priceDisplay}</span>
                <span class="text-sm text-[#301B69]/70">${isFree ? ' forever' : ` ${plan.period}`}</span>
              </div>
              <div class="border-t border-[#301B69]/10 mb-6"></div>
              <ul class="space-y-3 mb-6 list-none">${featuresHTML}</ul>
              <div>
                <a href="${appURL}" data-get-started data-source="pricing" data-plan="${plan.name}" class="${btnClass}">
                  ${isFree ? 'Get Started Free' : 'Get Started'}
                </a>
              </div>
            </article>
          </li>
        `;
      }).join('');
    } catch {
      const grid = document.getElementById('pricing-grid');
      if (grid) grid.innerHTML = '<li class="col-span-4 text-center text-[#301B69]/60 py-8">Unable to load pricing. Please try again later.</li>';
    }
  }

  loadPricing();
</script>
