---
// Compact inner-page header. Grid/glow is applied at page level in features.astro
// so it extends to the same height as the landing hero regardless of header size.
---
<div class="relative pt-[68px]">
  <div class="relative z-10 px-6 pt-32 pb-14">
    <div class="max-w-6xl mx-auto text-center">
      <h1 class="text-3xl md:text-5xl font-bold text-[#301B69] mb-4 leading-tight">
        Everything you need to build an AI agent<br class="hidden md:block" /> that actually knows your business
      </h1>
      <p class="text-[#301B69]/70 max-w-2xl mx-auto text-base md:text-lg">
        No prompt engineering. No infrastructure. No AI expertise required. Just your content, your brand, and the channels your customers already use.
      </p>
    </div>
  </div>
</div>
