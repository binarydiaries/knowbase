---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  ogType?: string;
  jsonLd?: object | object[];
  activePage?: 'blog';
  // article:* OG tags (used when ogType="article")
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  articleTags?: string[];
  articleSection?: string;
}

const {
  title = 'Agenvik — Build Your AI Agent',
  description = 'Upload your PDFs, paste your FAQ, or point it at your website — your AI agent goes live in minutes. No coding required. Deploy on your site, WhatsApp, or Slack.',
  ogImage = '/og-image.png',
  ogImageWidth = '1200',
  ogImageHeight = '630',
  ogType = 'website',
  jsonLd,
  activePage,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleTags,
  articleSection,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const appURL = import.meta.env.PUBLIC_APP_URL || 'https://app.agenvik.com';
const isStaging = import.meta.env.PUBLIC_ENV === 'stage';
const robotsContent = isStaging
  ? 'noindex, nofollow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';

const siteURL = 'https://agenvik.com';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteURL}/#organization`,
  name: 'Agenvik',
  url: siteURL,
  logo: {
    '@type': 'ImageObject',
    url: `${siteURL}/og-image.png`,
    width: 1200,
    height: 630,
  },
  sameAs: [
    'https://x.com/agenvik',
    'https://linkedin.com/company/agenvik',
    'https://instagram.com/agenvik',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'hello@agenvik.com',
    contactType: 'customer support',
    availableLanguage: 'English',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteURL}/#website`,
  name: 'Agenvik',
  url: siteURL,
  publisher: { '@id': `${siteURL}/#organization` },
};

const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#301B69" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Agenvik" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:type" content={ogImageURL.pathname.endsWith('.png') ? 'image/png' : 'image/jpeg'} />

    <!-- Article-specific OG tags -->
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    {articleTags?.map(tag => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@agenvik" />
    <meta name="twitter:creator" content="@agenvik" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Structured Data: Organization + WebSite (every page) -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Page-specific structured data -->
    {pageSchemas.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#301B69] focus:text-white focus:rounded-lg focus:text-sm">
      Skip to content
    </a>
    <Header activePage={activePage} base={activePage === 'blog' ? '/' : ''} />
    <slot />
  </body>
</html>
<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>
