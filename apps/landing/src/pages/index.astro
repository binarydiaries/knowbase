---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import ProblemSection from '../components/ProblemSection.astro';
import ComparisonSection from '../components/ComparisonSection.astro';
import HowItWorksSection from '../components/HowItWorksSection.astro';
import CoreValueSection from '../components/CoreValueSection.astro';
import UseCasesSection from '../components/UseCasesSection.astro';
import SocialProofSection from '../components/SocialProofSection.astro';
import PricingSection from '../components/PricingSection.astro';
import FAQSection from '../components/FAQSection.astro';
import FinalCTASection from '../components/FinalCTASection.astro';
import Footer from '../components/Footer.astro';
import { faqSchema, homepageFaqs } from '../data/faqs';

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': 'https://agenvik.com/#software',
  name: 'Agenvik',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: 'https://app.agenvik.com',
  description:
    'Agenvik is a no-code AI agent platform that lets businesses build and deploy conversational AI agents trained on their own data, deployable on websites, WhatsApp, and Slack.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'INR',
    description: 'Free plan available. Paid plans start from ₹499/month.',
  },
  publisher: { '@id': 'https://agenvik.com/#organization' },
  featureList: [
    'Upload PDF knowledge sources',
    'Paste FAQ and plain text',
    'Website URL crawling',
    'No-code AI agent builder',
    'Website chat widget embed',
    'WhatsApp integration',
    'Slack integration',
    'Custom agent behavior and tone',
    'Usage analytics',
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  '@id': 'https://agenvik.com/#howto',
  name: 'How to Build and Deploy an AI Agent with Agenvik',
  description: 'Follow these three steps to build, train, and deploy your AI agent — no technical expertise required.',
  totalTime: 'PT10M',
  estimatedCost: {
    '@type': 'MonetaryAmount',
    currency: 'INR',
    value: '0',
  },
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Add Your Knowledge',
      text: 'Upload PDFs, paste your FAQ, drop in a website URL, or type plain text. Your agent learns from whatever you already have — there\'s nothing new to write.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Configure Your Agent',
      text: 'Give your agent a name, a tone (friendly, formal, direct), and tell it which channels to live on. It takes 2 minutes. You can change anything later.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Go Live',
      text: 'Copy one line of code to embed on your website. Connect your WhatsApp business number. Link your Slack workspace. Your agent is live and handling queries immediately.',
    },
  ],
};

const homepageFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homepageFaqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---
<Layout
  title="Agenvik — AI Agent That Answers From Your Own Docs"
  description="Upload a PDF, paste your FAQ, or point it at your website. Your AI agent goes live on your site, WhatsApp, or Slack in 10 minutes. No coding. No hallucinations. Start free."
  jsonLd={[softwareAppSchema, homepageFaqSchema, howToSchema]}
>
  <main id="main-content">
    <HeroSection />
    <ProblemSection />
    <ComparisonSection />
    <HowItWorksSection />
    <CoreValueSection />
    <UseCasesSection />
    <SocialProofSection />
    <PricingSection />
    <FAQSection />
    <FinalCTASection />
  </main>
  <Footer />
</Layout>
