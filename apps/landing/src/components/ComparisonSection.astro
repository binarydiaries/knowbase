---
import { Check, X } from 'lucide-astro';

const appURL = import.meta.env.PUBLIC_APP_URL || 'https://app.agenvik.com';

const rows = [
  {
    feature: 'Learns directly from your documents',
    chatbot: false,
    chatbotNote: '(uses decision trees)',
    generic: false,
    genericNote: '(uses general training)',
    agenvik: true,
  },
  {
    feature: 'Cites the source for every answer',
    chatbot: false,
    generic: false,
    agenvik: true,
  },
  {
    feature: "Says \"I don't know\" instead of guessing",
    chatbot: false,
    chatbotNote: '(gives scripted fallback)',
    generic: false,
    genericNote: '(may confidently hallucinate)',
    agenvik: true,
  },
  {
    feature: 'One setup — same knowledge across all channels',
    chatbot: false,
    chatbotNote: '(separate per channel)',
    generic: false,
    genericNote: '(no deployment)',
    agenvik: true,
  },
  {
    feature: 'No scripts or decision trees to write',
    chatbot: false,
    generic: true,
    agenvik: true,
  },
  {
    feature: 'Live in under 10 minutes',
    chatbot: false,
    chatbotNote: '(scripting takes time)',
    generic: true,
    agenvik: true,
  },
];

---
<section aria-labelledby="comparison-heading" class="px-6 pt-16">
  <div class="max-w-6xl mx-auto">
    <div class="relative rounded-3xl p-10 md:p-14 overflow-hidden bg-white border border-[#301B69]/10 shadow-sm">

      <div class="text-center mb-10">
        <div class="inline-flex items-center px-4 py-1 text-xs rounded-full bg-[#301B69]/8 text-[#301B69] mb-4" aria-hidden="true">
          ✦ WHY AGENVIK
        </div>
        <h2 id="comparison-heading" class="text-3xl md:text-4xl font-bold text-[#301B69] mb-3">
          Why not just use ChatGPT?
        </h2>
        <p class="text-[#301B69]/70 text-sm md:text-base max-w-2xl mx-auto">
          Generic AI makes things up. Chatbot builders make you write scripts. Agenvik reads your documents and answers from them — accurately, every time.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse" role="table" aria-label="Agenvik vs chatbot builders vs generic AI comparison">
          <thead>
            <tr>
              <th class="text-left py-3 px-4 text-[#301B69]/50 font-medium w-1/2" scope="col">Feature</th>
              <th class="text-center py-3 px-4 text-[#301B69]/50 font-medium" scope="col">Chatbot builder</th>
              <th class="text-center py-3 px-4 text-[#301B69]/50 font-medium" scope="col">Generic AI (ChatGPT etc.)</th>
              <th class="text-center py-3 px-4 font-semibold text-white bg-[#301B69] rounded-t-xl" scope="col">
                Agenvik
              </th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row, i) => (
              <tr class:list={['border-t border-[#301B69]/8', i % 2 === 0 ? 'bg-[#301B69]/[0.02]' : '']}>
                <td class="py-3.5 px-4 text-[#301B69] font-medium">{row.feature}</td>

                <td class="py-3.5 px-4 text-center align-top">
                  <span class:list={[row.chatbot ? 'text-emerald-600' : 'text-[#301B69]/30', 'inline-flex justify-center']} aria-hidden="true">
                    {row.chatbot ? <Check size={18} strokeWidth={2.5} /> : <X size={18} strokeWidth={2.5} />}
                  </span>
                  {row.chatbotNote && <span class="block text-[10px] text-[#301B69]/40 mt-0.5 leading-tight">{row.chatbotNote}</span>}
                </td>

                <td class="py-3.5 px-4 text-center align-top">
                  <span class:list={[row.generic ? 'text-emerald-600' : 'text-[#301B69]/30', 'inline-flex justify-center']} aria-hidden="true">
                    {row.generic ? <Check size={18} strokeWidth={2.5} /> : <X size={18} strokeWidth={2.5} />}
                  </span>
                  {row.genericNote && <span class="block text-[10px] text-[#301B69]/40 mt-0.5 leading-tight">{row.genericNote}</span>}
                </td>

                <td class:list={['py-3.5 px-4 text-center bg-[#301B69]/5 align-top', i === rows.length - 1 && 'rounded-b-xl']}>
                  <span class="text-[#301B69] inline-flex justify-center" aria-hidden="true">
                    <Check size={18} strokeWidth={2.5} />
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-8 text-center">
        <a
          href={appURL}
          data-get-started
          data-source="comparison"
          class="inline-flex px-6 py-3 bg-[#301B69] text-white rounded-xl font-medium hover:opacity-90 transition-opacity"
        >
          Try Agenvik free →
        </a>
        <p class="mt-3 text-xs text-[#301B69]/50">No credit card. Live in 10 minutes.</p>
      </div>
    </div>
  </div>
</section>
