---
import { Image, getImage } from 'astro:assets';
import dashboardSrc from '../assets/images/hero-dashboard.png';
import heroBgSrc from '../assets/images/hero-bg.png';

const heroBg = await getImage({ src: heroBgSrc, format: 'webp', quality: 80 });
const appURL = import.meta.env.PUBLIC_APP_URL || 'https://app.agenvik.com';
---
<section
  aria-label="Hero"
  class="relative w-full overflow-hidden bg-white pt-[68px]"
>
  <!-- Grid pattern -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-image: linear-gradient(rgba(48,27,105,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(48,27,105,0.07) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, white 0%, white 55%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, white 0%, white 55%, transparent 100%);"
    aria-hidden="true"
  ></div>
  <!-- Soft radial highlight so the grid doesn't feel flat -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_50%_0%,rgba(124,58,237,0.08),transparent)] pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 text-center max-w-4xl mx-auto px-6 pt-16 pb-28">
    <p class="inline-block text-sm text-[#301B69]/70 mb-5 tracking-wide">
      Free to start · No code · Live in 10 minutes
    </p>

    <h1 class="text-4xl md:text-6xl mb-6 leading-tight tracking-tight text-[#301B69]">
      <span class="block font-normal">Your customers ask.</span>
      <span class="block font-bold">Your AI agent answers — from your own docs.</span>
    </h1>

    <p class="text-[#301B69]/80 mb-8 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
      Upload a PDF, paste your FAQ, or point it at your website. Your agent goes live on your site, WhatsApp, or Slack. No coding. No hallucinations. No waiting.
    </p>

    <div class="flex justify-center gap-4 flex-wrap items-center">
      <a
        href={appURL}
        data-get-started
        data-source="hero_body"
        class="px-6 py-3 bg-[#301B69] text-white rounded-xl font-medium hover:opacity-90 transition-opacity"
      >
        Start for free →
      </a>
      <a
        href="/book-demo"
        class="px-6 py-3 text-[#301B69] bg-white rounded-xl border border-[#301B69]/20 hover:bg-[#301B69]/5 transition-colors"
      >
        ▶ Watch 2-min demo
      </a>
    </div>

    <p class="mt-5 text-sm text-[#301B69]/60">
      Free plan. No credit card required. Cancel anytime.
    </p>
  </div>

  <div class="relative z-10 max-w-5xl mx-auto px-6 -mt-16 pb-10">
    <Image
      src={dashboardSrc}
      alt="Agenvik platform dashboard showing AI agent creation and management interface"
      class="rounded-2xl shadow-2xl ring-1 ring-[#301B69]/15 w-full"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var getStarted = document.querySelector('[aria-label="Hero"] [data-get-started]');
    if (getStarted) {
      getStarted.addEventListener('click', function () {
        window.amplitude?.track('Get Started Clicked', { source: 'hero' });
      });
    }

    var bookDemo = document.querySelector('[aria-label="Hero"] a[href="/book-demo"]');
    if (bookDemo) {
      bookDemo.addEventListener('click', function () {
        window.amplitude?.track('Book Demo Clicked', { source: 'hero' });
      });
    }
  });
</script>
