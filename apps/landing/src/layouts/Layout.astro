---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: object | object[];
  activePage?: 'blog';
}

const {
  title = 'Agenvik — Build Your AI Agent',
  description = 'Upload your PDFs, paste your FAQ, or point it at your website — your AI agent goes live in minutes. No coding required. Deploy on your site, WhatsApp, or Slack.',
  ogImage = '/og-image.png',
  ogType = 'website',
  jsonLd,
  activePage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const amplitudeKey = import.meta.env.PUBLIC_AMPLITUDE_API_KEY;
const appURL = import.meta.env.PUBLIC_APP_URL || 'https://app.agenvik.com';

const siteURL = 'https://agenvik.com';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteURL}/#organization`,
  name: 'Agenvik',
  url: siteURL,
  logo: {
    '@type': 'ImageObject',
    url: `${siteURL}/og-image.png`,
    width: 1200,
    height: 630,
  },
  sameAs: [
    'https://x.com/agenvik',
    'https://linkedin.com/company/agenvik',
    'https://instagram.com/agenvik',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'hello@agenvik.com',
    contactType: 'customer support',
    availableLanguage: 'English',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteURL}/#website`,
  name: 'Agenvik',
  url: siteURL,
  publisher: { '@id': `${siteURL}/#organization` },
};

const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="theme-color" content="#301B69" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Agenvik" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@agenvik" />
    <meta name="twitter:creator" content="@agenvik" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Structured Data: Organization + WebSite (every page) -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Page-specific structured data -->
    {pageSchemas.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#301B69] focus:text-white focus:rounded-lg focus:text-sm">
      Skip to content
    </a>
    <Header activePage={activePage} base={activePage === 'blog' ? '/' : ''} />
    <slot />
  </body>
</html>

{amplitudeKey && (
  <script type="module" define:vars={{ amplitudeKey, appURL }}>
    import * as amplitude from 'https://cdn.amplitude.com/libs/unified/1.1.0/amplitude.esm.min.js';
    amplitude.initAll(amplitudeKey, { analytics: { autocapture: true } });

    document.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-get-started]');
      if (!btn) return;
      amplitude.analytics.track('Get Started Clicked', {
        source: btn.dataset.source || 'unknown',
        ...(btn.dataset.plan ? { plan_name: btn.dataset.plan } : {}),
      });
    });

    window.__amplitude = amplitude;
    window.__appURL = appURL;
  </script>
)}

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>
