{
  "name": "knowbase",
  "private": true,
  "description": "Agenvik \u2014 build AI agents from your knowledge base and deploy them across web, WhatsApp, and Slack.",
  "license": "MIT",
  "homepage": "https://agenvik.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/binarydiaries/knowbase.git"
  },
  "bugs": {
    "url": "https://github.com/binarydiaries/knowbase/issues"
  },
  "scripts": {
    "build": "turbo run build",
    "build:dashboard": "turbo run build --filter=dashboard",
    "build:landing": "turbo run build --filter=landing",
    "build:client": "turbo run build --filter=client",
    "build:embed": "turbo run build --filter=embed",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "check-types": "turbo run check-types",
    "test": "bun run --cwd apps/backend test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "0.7.0.0",
  "overrides": {
    "ioredis": "5.11.1",
    "astro": "^7.4.1",
    "@ai-sdk/provider-utils@<4.0.33": "^4.0.33",
    "axios@<1.20.0": "^1.20.0",
    "baseline-browser-mapping@<2.11.0": "^2.11.0",
    "browserslist@<4.28.7": "^4.28.7",
    "devalue@<5.9.3": "^5.9.3",
    "fast-copy@<4.1.0": "^4.1.0",
    "fflate@>=0.4.5 <0.4.9": "^0.4.9",
    "follow-redirects@>=1.16.0 <1.16.1": "^1.16.1",
    "http-cache-semantics@<4.2.1": "^4.2.1",
    "js-yaml@>=4 <4.3.2": "^4.3.2",
    "nanoid@<3.3.18": "^3.3.18",
    "postcss@<8.5.23": "^8.5.23",
    "prosemirror-view@<1.42.3": "^1.42.3",
    "seroval@<1.6.3": "^1.6.3",
    "smol-toml@<1.8.1": "^1.8.1",
    "source-map-js@<1.2.2": "^1.2.2",
    "svgo@>=4 <4.1.0": "^4.1.0",
    "sharp@<0.35.5": "^0.35.5",
    "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
    "brace-expansion@>=3 <5.0.12": "^5.0.12",
    "uuid@<11.1.1": "^11.1.1",
    "vite@>=7 <7.3.7": "^7.3.7"
  }
}
