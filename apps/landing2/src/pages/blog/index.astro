---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostCard from '../../components/PostCard.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((p) => p.data.published)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allTags = Array.from(new Set(posts.flatMap((p) => p.data.tags)));
---

<BlogLayout
  title="Agenvik Blog — AI Agents, Tutorials & Insights"
  description="Explore the Agenvik blog for guides on AI agents, knowledge base building, customer support automation, and more."
>
  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-10 text-center">
    <div
      class="inline-flex px-4 py-1 text-xs rounded-full bg-white/70 border border-[#301B69]/10 text-[#301B69] mb-4"
      aria-hidden="true"
    >
      ✦ BLOG
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-[#301B69] mb-4 leading-tight">
      Insights on AI Agents<br />
      <span class="bg-gradient-to-b from-[#301B69] to-[#B07CD1] bg-clip-text text-transparent">
        and Knowledge Automation
      </span>
    </h1>
    <p class="text-[#301B69]/70 max-w-xl mx-auto leading-relaxed">
      Tutorials, guides, and product updates to help you build smarter AI agents with Agenvik.
    </p>
  </section>

  <!-- Tag filter -->
  <div class="max-w-6xl mx-auto px-6 mb-8 flex flex-wrap gap-2 justify-center" id="tag-filter">
    <button
      data-tag=""
      class="tag-btn active px-3 py-1 rounded-full text-sm border transition bg-[#301B69] text-white border-[#301B69]"
    >
      All
    </button>
    {allTags.map((tag) => (
      <button
        data-tag={tag}
        class="tag-btn px-3 py-1 rounded-full text-sm border transition bg-white text-[#301B69] border-[#301B69]/20 hover:border-[#301B69]/50"
      >
        {tag}
      </button>
    ))}
  </div>

  <!-- Post grid -->
  <section class="max-w-6xl mx-auto px-6 pb-16" aria-label="Blog posts">
    {posts.length === 0 ? (
      <p class="text-center text-[#301B69]/50 py-16">No posts yet — check back soon.</p>
    ) : (
      <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 list-none" id="posts-grid">
        {posts.map((post) => (
          <li data-tags={post.data.tags.join(',')}>
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    )}
  </section>
</BlogLayout>

<!-- Client-side tag filter (vanilla JS, no framework needed) -->
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
  const items = document.querySelectorAll<HTMLLIElement>('#posts-grid li');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selectedTag = btn.dataset.tag ?? '';

      buttons.forEach((b) => {
        const isActive = b.dataset.tag === selectedTag;
        b.classList.toggle('active', isActive);
        b.classList.toggle('bg-[#301B69]', isActive);
        b.classList.toggle('text-white', isActive);
        b.classList.toggle('border-[#301B69]', isActive);
        b.classList.toggle('bg-white', !isActive);
        b.classList.toggle('text-[#301B69]', !isActive);
        b.classList.toggle('border-[#301B69]/20', !isActive);
      });

      items.forEach((item) => {
        const tags = item.dataset.tags?.split(',') ?? [];
        const show = selectedTag === '' || tags.includes(selectedTag);
        item.style.display = show ? '' : 'none';
      });
    });
  });
</script>
