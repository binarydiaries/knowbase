---
const appURL = import.meta.env.PUBLIC_APP_URL || 'https://app.agenvik.com';
---
<section
  aria-label="Hero"
  class="relative w-full overflow-hidden bg-cover bg-center"
  style="background-image: url('/hero-bg.png')"
>
  <div class="absolute inset-0 bg-white/40 backdrop-blur-[2px]" aria-hidden="true"></div>

  <header class="relative z-20 max-w-6xl mx-auto px-6 pt-6">
    <div class="flex items-center justify-between bg-white/60 backdrop-blur-md px-6 py-3 rounded-2xl">
      <a href="/" aria-label="Agenvik home">
        <img src="/TextLogo.svg" alt="Agenvik" class="h-7 w-auto" />
      </a>

      <nav aria-label="Main navigation" class="hidden md:flex gap-8 text-sm text-[#301B69]">
        <a href="#features" class="hover:opacity-80">Features</a>
        <a href="#how-it-works" class="hover:opacity-80">How it Works</a>
        <a href="#pricing" class="hover:opacity-80">Pricing</a>
        <a href="#faq" class="hover:opacity-80">FAQ</a>
        <a href="/book-demo" class="hover:opacity-80">Book a Demo</a>
      </nav>

      <a
        href={appURL}
        data-get-started
        data-source="hero_nav"
        class="bg-[#301B69] text-white px-4 py-2 rounded-lg text-sm"
      >
        Get Started
      </a>
    </div>
  </header>

  <div class="relative z-10 text-center max-w-4xl mx-auto px-6 pt-16 pb-28">
    <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight tracking-tight">
      <span class="bg-gradient-to-b from-[#301B69] to-[#B07CD1] bg-clip-text text-transparent">
        The Fastest Way to
      </span>
      <br />
      <span class="text-[#301B69]">Build Your AI Agent</span>
    </h1>

    <p class="text-[#301B69] mb-8">
      Upload your PDFs, paste your FAQ, or point it at your website — your
      AI agent goes live in minutes.
      <br /> No coding required. Deploy on your site, WhatsApp, or Slack.
    </p>

    <div class="flex justify-center gap-4 flex-wrap">
      <a
        href={appURL}
        data-get-started
        data-source="hero_body"
        class="px-6 py-3 bg-[#301B69] text-white rounded-xl"
      >
        Get Started →
      </a>
      <a
        href="/book-demo"
        class="px-6 py-3 text-[#301B69] bg-white rounded-xl"
      >
        Book a Demo
      </a>
    </div>
  </div>

  <div class="relative z-10 max-w-5xl mx-auto px-6 -mt-16 pb-10">
    <img
      src="/hero-dashboard.png"
      alt="Agenvik platform dashboard showing AI agent creation and management interface"
      class="rounded-2xl shadow-2xl w-full opacity-90"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-white/60 to-transparent rounded-2xl"
      aria-hidden="true"
    ></div>
  </div>
</section>
