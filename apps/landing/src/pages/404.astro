---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { FileQuestion } from '@lucide/astro';
---

<Layout
  title="Page Not Found — Agenvik"
  description="The page you're looking for doesn't exist. Head back to Agenvik and explore our AI agent platform."
  activePage=""
>
  <main id="main-content">
    <section
      class="relative w-full overflow-hidden bg-white pt-[68px]"
      aria-label="Page not found"
    >
      <!-- Grid background -->
      <div
        class="absolute inset-0 pointer-events-none"
        style="background-image: linear-gradient(rgba(48,27,105,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(48,27,105,0.07) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, white 0%, white 60%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, white 0%, white 60%, transparent 100%);"
        aria-hidden="true"
      ></div>
      <!-- Radial glow -->
      <div
        class="absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_50%_0%,rgba(124,58,237,0.08),transparent)] pointer-events-none"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 max-w-lg mx-auto px-6 pt-20 pb-24 text-center">

        <!-- Icon -->
        <div aria-hidden="true" style="width:64px;height:64px;border-radius:16px;background:rgba(48,27,105,0.08);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
          <FileQuestion class="w-8 h-8 text-[#301B69]/50" strokeWidth={1.5} />
        </div>

        <!-- Error label -->
        <p aria-hidden="true" class="text-xs font-semibold text-[#301B69]/40 uppercase tracking-widest mb-5">
          Error 404
        </p>

        <!-- Headline -->
        <h1 class="text-3xl md:text-4xl font-bold text-[#301B69] leading-tight tracking-tight mb-3">
          This page doesn't exist.
        </h1>
        <p class="text-lg font-normal text-[#301B69]/50 mb-6">
          But your AI agent can.
        </p>

        <!-- Description -->
        <p class="text-[#301B69]/55 text-sm leading-relaxed max-w-xs mx-auto mb-10">
          The URL you followed may be broken or the page may have moved.
        </p>

        <!-- Primary CTAs -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center mb-12">
          <a
            href="/"
            class="px-6 py-3 bg-[#301B69] text-white rounded-xl font-semibold text-sm hover:opacity-90 transition-opacity"
          >
            ← Back to home
          </a>
          <a
            href="https://app.agenvik.com"
            class="px-6 py-3 border border-[#301B69]/20 text-[#301B69] rounded-xl font-semibold text-sm hover:bg-[#301B69]/5 transition-colors"
          >
            Start building free →
          </a>
        </div>

        <!-- Quick links -->
        <nav aria-label="Helpful links" class="flex flex-wrap items-center justify-center text-sm text-[#301B69]/40">
          <a href="/use-cases" class="px-3 py-1 hover:text-[#301B69] transition-colors">Use Cases</a>
          <span aria-hidden="true" class="text-[#301B69]/25">·</span>
          <a href="/pricing" class="px-3 py-1 hover:text-[#301B69] transition-colors">Pricing</a>
          <span aria-hidden="true" class="text-[#301B69]/25">·</span>
          <a href="/features" class="px-3 py-1 hover:text-[#301B69] transition-colors">Features</a>
          <span aria-hidden="true" class="text-[#301B69]/25">·</span>
          <a href="/faq" class="px-3 py-1 hover:text-[#301B69] transition-colors">FAQ</a>
          <span aria-hidden="true" class="text-[#301B69]/25">·</span>
          <a href="/book-demo" class="px-3 py-1 hover:text-[#301B69] transition-colors">Book a demo</a>
        </nav>

      </div>
    </section>
  </main>
  <Footer />
</Layout>
