---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="About — Agenvik"
  description="Agenvik is a no-code AI agent platform built for businesses that want accurate, on-brand answers without the complexity. Learn about our mission and team."
>
  <main id="main-content" class="pt-[68px]">
    <section class="px-6 pt-20 pb-20 max-w-3xl mx-auto text-center">
      <div class="inline-flex px-4 py-1 text-xs rounded-full bg-[#301B69]/8 text-[#301B69] mb-4" aria-hidden="true">
        ✦ ABOUT US
      </div>
      <h1 class="text-3xl md:text-5xl font-bold text-[#301B69] mb-6">
        We believe every business deserves AI that actually works.
      </h1>
      <p class="text-[#301B69]/70 text-base md:text-lg mb-6 leading-relaxed">
        Agenvik started from a simple observation: most businesses repeat themselves constantly — to customers, to new hires, to anyone who asks. The answers exist. They're just locked in PDFs, Notion pages, and the heads of senior employees.
      </p>
      <p class="text-[#301B69]/70 text-base md:text-lg mb-10 leading-relaxed">
        We built Agenvik to unlock that knowledge. Upload your documents, deploy your agent, and let it handle the questions — accurately, 24/7, in your brand's voice.
      </p>
      <a href="mailto:hello@agenvik.com" class="inline-flex px-6 py-3 bg-[#301B69] text-white rounded-xl font-medium hover:opacity-90 transition-opacity">
        Say hello →
      </a>
    </section>
  </main>
  <Footer />
</Layout>
