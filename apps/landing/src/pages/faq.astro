---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { faqs, faqSchema } from '../data/faqs';
---
<Layout
  title="FAQ — Agenvik"
  description="Answers to the most common questions about Agenvik — features, security, pricing, integrations, and getting started."
  jsonLd={[faqSchema]}
>
  <main id="main-content" class="pt-[68px]">
    <section aria-labelledby="faq-page-heading" class="px-6 pt-16 pb-16">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <div class="inline-flex px-4 py-1 text-xs rounded-full bg-[#301B69]/8 text-[#301B69] mb-4" aria-hidden="true">
            ✦ FAQ
          </div>
          <h1 id="faq-page-heading" class="text-3xl md:text-4xl font-bold text-[#301B69] mb-3">
            Frequently Asked Questions
          </h1>
          <p class="text-[#301B69]/70 text-sm md:text-base max-w-xl mx-auto">
            Find answers about Agenvik — features, security, pricing, and more.
          </p>
        </div>

        <div class="space-y-3">
          {faqs.map((faq) => (
            <div class="rounded-xl border border-[#301B69]/10 bg-white overflow-hidden">
              <details class="group">
                <summary class="flex w-full justify-between items-center text-left cursor-pointer p-4 list-none [&::-webkit-details-marker]:hidden">
                  <span class="text-sm md:text-base font-medium text-[#301B69]">{faq.question}</span>
                  <svg
                    class="w-5 h-5 text-[#301B69] transition-transform flex-shrink-0 group-open:rotate-180 ml-3"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </summary>
                <p class="px-4 pb-4 text-sm text-[#301B69]/70 leading-relaxed">
                  {faq.answer}
                </p>
              </details>
            </div>
          ))}
        </div>

        <div class="mt-12 text-center">
          <p class="text-[#301B69]/60 text-sm mb-4">Still have questions?</p>
          <a href="mailto:hello@agenvik.com" class="inline-flex px-6 py-3 bg-[#301B69] text-white rounded-xl text-sm font-medium hover:opacity-90 transition-opacity">
            Contact us →
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
