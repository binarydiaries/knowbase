{
  "name": "backend",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:app": "bun run --watch src/server.ts",
    "dev:worker": "bun run --watch src/queue/worker.ts",
    "dev": "bun run dev:app & bun run dev:worker",
    "build:app": "bun build \\\n\t--compile \\\n\t--minify-whitespace \\\n\t--minify-syntax \\\n\t--target bun \\\n\t--outfile out/server \\\n\tsrc/index.ts",
    "build:worker": "bun build \\\n\t--compile \\\n\t--minify-whitespace \\\n\t--minify-syntax \\\n\t--target bun \\\n\t--outfile out/worker-server \\\n\tsrc/queue/worker.ts",
    "build": "bun run build:app && bun run build:worker",
    "start:app": "./out/server",
    "start:worker": "./out/worker-server",
    "start": "bun run start:app & bun run start:worker",
    "db:push": "npx drizzle-kit push",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "studio": "npx drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.1",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/openapi": "1.4.11",
    "@langchain/textsplitters": "^1.0.1",
    "@paralleldrive/cuid2": "^3.0.6",
    "@sentry/elysia": "^10.51.0",
    "ai": "^6.0.3",
    "bullmq": "^5.69.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^1.0.0-beta.15-859cf75",
    "elysia": "^1.4.13",
    "elysia-clerk": "^0.13.2",
    "elysia-helmet": "^3.1.0",
    "elysia-rate-limit": "^4.6.1",
    "ioredis": "^5.9.3",
    "node-html-parser": "^7.1.0",
    "pg": "^8.16.3",
    "razorpay": "^2.9.6",
    "resend": "^6.12.2",
    "unpdf": "^1.6.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "bun-types": "^1.3.5",
    "drizzle-kit": "^1.0.0-beta.15-859cf75",
    "tsx": "^4.21.0"
  },
  "module": "src/index.js"
}
