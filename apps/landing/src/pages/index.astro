---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import CoreValueSection from '../components/CoreValueSection.astro';
import UseCasesSection from '../components/UseCasesSection.astro';
import PlatformSection from '../components/PlatformSection.astro';
import HowItWorksSection from '../components/HowItWorksSection.astro';
import PricingSection from '../components/PricingSection.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';
import { faqSchema } from '../data/faqs';

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': 'https://agenvik.com/#software',
  name: 'Agenvik',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: 'https://app.agenvik.com',
  description:
    'Agenvik is a no-code AI agent platform that lets businesses build and deploy conversational AI agents trained on their own data, deployable on websites, WhatsApp, and Slack.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'INR',
    description: 'Free plan available. Paid plans start from ₹0/month.',
  },
  publisher: { '@id': 'https://agenvik.com/#organization' },
  featureList: [
    'Upload PDF knowledge sources',
    'Paste FAQ and plain text',
    'Website URL crawling',
    'No-code AI agent builder',
    'Website chat widget embed',
    'WhatsApp integration',
    'Slack integration',
    'Custom agent behavior and tone',
    'Usage analytics',
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  '@id': 'https://agenvik.com/#howto',
  name: 'How to Build and Deploy an AI Agent with Agenvik',
  description: 'Follow these simple steps to build, train, and deploy your AI agent — no technical expertise required.',
  totalTime: 'PT10M',
  estimatedCost: {
    '@type': 'MonetaryAmount',
    currency: 'INR',
    value: '0',
  },
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Set Up Your Account',
      text: 'Create your workspace and get started in seconds. Sign up with minimal friction and access your dashboard instantly. No complex onboarding — just a smooth entry into building AI agents.',
      image: 'https://agenvik.com/step1.png',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Create Your Agent',
      text: 'Define your agent\'s purpose, name, and identity. Whether it\'s for support, learning, or internal use — set the intent clearly. Each agent is independent and fully customizable.',
      image: 'https://agenvik.com/step2.png',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Add Knowledge',
      text: 'Upload your content or add structured FAQs. Train your agent using real data that matters to you. Your agent learns context, not just keywords. Continuously update its knowledge as your needs evolve.',
      image: 'https://agenvik.com/step3.png',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Customize Behavior',
      text: 'Control how your agent thinks and responds. Adjust tone, personality, and response style. Fine-tune outputs to match your brand or use case.',
      image: 'https://agenvik.com/step4.png',
    },
    {
      '@type': 'HowToStep',
      position: 5,
      name: 'Embed and Share',
      text: 'Deploy your agent wherever your users are. Embed it on websites or use it internally with your team. Share access instantly — no complex integrations required.',
      image: 'https://agenvik.com/step5.png',
    },
  ],
};
---
<Layout
  title="Agenvik — The Fastest Way to Build Your AI Agent"
  description="Upload your PDFs, paste your FAQ, or point it at your website — your AI agent goes live in minutes. No coding required. Deploy on your site, WhatsApp, or Slack."
  jsonLd={[softwareAppSchema, faqSchema, howToSchema]}
>
  <main id="main-content">
    <HeroSection />
    <CoreValueSection />
    <UseCasesSection />
    <PlatformSection />
    <HowItWorksSection />
    <PricingSection />
    <FAQSection />
  </main>
  <Footer />
</Layout>
