---
import { Home, Hospital, Users, GraduationCap } from '@lucide/astro';

const useCases = [
  {
    Icon: Home,
    title: 'Real Estate',
    headline: 'Stop answering the same property questions on WhatsApp.',
    desc: 'Property prices, availability, documents needed, process overview — your agent handles the flood of WhatsApp messages 24/7. You focus on leads who are ready to move.',
    href: '/use-cases/real-estate',
  },
  {
    Icon: Hospital,
    title: 'Clinics & Hospitals',
    headline: 'Free your front desk from repetitive calls.',
    desc: 'Hours, services, insurance accepted, appointment process — your agent handles the queries that tie up your staff, so they can focus on patients in front of them.',
    href: '/use-cases/clinic',
  },
  {
    Icon: Users,
    title: 'Internal Teams',
    headline: 'New hire asks Slack. Gets the answer. Done.',
    desc: "Stop being the person everyone DMs for things that should be written down. Your agent knows your SOPs, processes, and company docs. Knowledge stops leaving when people do.",
    href: '/use-cases/internal-knowledge',
  },
  {
    Icon: GraduationCap,
    title: 'Coaches & Educators',
    headline: 'Your expertise. Available 24/7.',
    desc: 'Turn your course material, workbooks, or coaching notes into an agent your students can ask anything, anytime. Personalised answers at scale.',
    href: '/use-cases/education',
  },
];
---
<section aria-labelledby="usecases-heading" class="px-6 pt-16">
  <div class="max-w-6xl mx-auto">
    <div class="relative rounded-3xl p-10 md:p-14 overflow-hidden bg-[#1a0f3d]">
      <div class="absolute -top-32 right-0 w-[500px] h-[400px] bg-[radial-gradient(ellipse_at_center,rgba(48,27,105,0.4),transparent_70%)]" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-[radial-gradient(ellipse_at_center,rgba(176,124,209,0.2),transparent_70%)]" aria-hidden="true"></div>

      <div class="relative z-10">
        <div class="inline-flex items-center gap-2 px-4 py-1 text-xs rounded-full bg-white/10 text-white/80 mb-6" aria-hidden="true">
          ✦ WHO USES AGENVIK
        </div>

        <h2 id="usecases-heading" class="text-3xl md:text-4xl font-bold text-white mb-3">
          Whatever your business. Wherever your customers are.
        </h2>

        <div class="grid md:grid-cols-2 gap-6 mt-10">
          {useCases.map((item) => (
            <div class="rounded-2xl bg-white/8 border border-white/10 p-6">
              <div class="flex items-start gap-3 mb-3">
                <div class="mt-0.5 text-white/70 flex-shrink-0" aria-hidden="true">
                  <item.Icon size={20} strokeWidth={1.75} />
                </div>
                <div>
                  <p class="text-xs text-white/40 uppercase tracking-widest mb-0.5">{item.title}</p>
                  <h3 class="font-semibold text-white">{item.headline}</h3>
                </div>
              </div>
              <p class="text-sm text-white/60 leading-relaxed mb-4">{item.desc}</p>
              {item.href && (
                <a href={item.href} class="text-sm text-white/70 font-medium hover:text-white transition-colors">
                  See how it works →
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
