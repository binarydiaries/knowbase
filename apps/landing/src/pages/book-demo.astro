---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE || '';
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || '';

const siteURL = 'https://agenvik.com';
const pageURL = `${siteURL}/book-demo`;

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageURL,
  url: pageURL,
  name: 'Book an Agenvik Demo — Watch Your Docs Become an AI Agent Live',
  description:
    'Schedule a 30-minute personalised walkthrough of Agenvik. Bring your own documents and watch a working AI agent take shape in real time.',
  isPartOf: { '@id': `${siteURL}/#website` },
  about: { '@id': `${siteURL}/#organization` },
  publisher: { '@id': `${siteURL}/#organization` },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['#page-description'],
  },
  dateModified: '2025-05-23',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
      { '@type': 'ListItem', position: 2, name: 'Book a Demo', item: pageURL },
    ],
  },
};
---
<Layout
  title="Book an Agenvik Demo — Watch Your Docs Become an AI Agent Live"
  description="Schedule a 30-minute personalised walkthrough of Agenvik. Bring your own documents and watch a working AI agent take shape in real time."
  jsonLd={[webPageSchema]}
>
  <main id="main-content" class="relative w-full overflow-hidden bg-white pt-[68px]">

    <!-- Grid background -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background-image: linear-gradient(rgba(48,27,105,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(48,27,105,0.07) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, white 0%, white 50%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, white 0%, white 50%, transparent 100%);"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_50%_0%,rgba(124,58,237,0.07),transparent)] pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 max-w-6xl mx-auto px-6 py-16 grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">

      <!-- ── LEFT: CONTEXT ── -->
      <div class="lg:pt-4 lg:sticky lg:top-28">
        <div aria-hidden="true" class="inline-flex items-center gap-1.5 px-4 py-1 text-xs font-semibold rounded-full bg-[#301B69]/8 text-[#301B69] mb-6 tracking-widest uppercase">
          <span>✦</span> Book a Demo
        </div>

        <h1 class="text-3xl md:text-4xl font-bold text-[#301B69] leading-tight tracking-tight mb-4">
          Watch your knowledge become an AI agent — live
        </h1>
        <p id="page-description" class="text-[#301B69]/60 text-base leading-relaxed mb-8">
          A 30-minute session built around your business. Bring your own docs — we'll build a working Agenvik agent together and show you exactly how it handles real questions.
        </p>

        <!-- What you'll see -->
        <div class="mb-8">
          <p class="text-xs font-semibold text-[#301B69]/40 uppercase tracking-widest mb-4">What you'll see</p>
          <ul class="space-y-3">
            {[
              'Upload your own documents — PDFs, FAQs, policies — and watch an agent take shape in real time',
              'Ask it live questions to see how it handles your actual use case',
              'Deploy it to your website, WhatsApp, or Slack channel before the session ends',
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm text-[#301B69]/70 leading-relaxed">
                <span class="w-5 h-5 rounded-full bg-[#301B69]/8 flex items-center justify-center flex-shrink-0 mt-0.5 text-[10px] font-bold text-[#301B69]/50">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Trust line -->
        <p class="text-sm text-[#301B69]/45 border-t border-[#301B69]/8 pt-5">
          No slides. No sales pitch. We respond within one business day to schedule a time that works for you.
        </p>
      </div>

      <!-- ── RIGHT: FORM ── -->
      <div>
        <!-- Success state (hidden initially) -->
        <div id="success-state" class="hidden bg-white rounded-3xl border border-[#301B69]/10 shadow-sm p-10 text-center">
          <div class="text-5xl mb-6">🎉</div>
          <h2 class="text-2xl font-bold text-[#301B69] mb-3">Thanks! We'll be in touch shortly.</h2>
          <p class="text-[#301B69]/60 mb-8">
            We've received your details and will reach out within one business day to schedule your personalised demo.
          </p>
          <a href="/" class="inline-block px-6 py-2.5 bg-[#301B69] text-white rounded-xl text-sm font-medium hover:opacity-90 transition">
            Back to Home
          </a>
        </div>

        <!-- Form state -->
        <div id="form-state" class="bg-white rounded-3xl border border-[#301B69]/10 shadow-sm p-8 md:p-10">
          <div class="mb-7">
            <h2 class="text-xl font-bold text-[#301B69] mb-1">Request your demo</h2>
            <p class="text-[#301B69]/55 text-sm">
              Fill in your details and we'll reach out to schedule a time.
            </p>
          </div>

        <form id="demo-form" novalidate class="space-y-5">
          <div class="flex flex-col gap-1">
            <label class="text-xs font-medium text-[#301B69]/70" for="name">
              Full Name <span class="text-red-500">*</span>
            </label>
            <input
              id="name" name="name" type="text" placeholder="Jane Smith" autocomplete="name"
              class="w-full rounded-xl border border-[#301B69]/15 px-4 py-2.5 text-sm text-[#301B69] outline-none placeholder:text-[#301B69]/30 focus:ring-2 focus:ring-[#301B69]/20 focus:border-[#301B69]/40 transition"
            />
            <p class="text-xs text-red-600 hidden" data-error="name"></p>
          </div>

          <div class="flex flex-col gap-1">
            <label class="text-xs font-medium text-[#301B69]/70" for="email">
              Work Email <span class="text-red-500">*</span>
            </label>
            <input
              id="email" name="email" type="email" placeholder="jane@company.com" autocomplete="email"
              class="w-full rounded-xl border border-[#301B69]/15 px-4 py-2.5 text-sm text-[#301B69] outline-none placeholder:text-[#301B69]/30 focus:ring-2 focus:ring-[#301B69]/20 focus:border-[#301B69]/40 transition"
            />
            <p class="text-xs text-red-600 hidden" data-error="email"></p>
          </div>

          <div class="flex flex-col gap-1">
            <label class="text-xs font-medium text-[#301B69]/70" for="company">
              Company <span class="text-red-500">*</span>
            </label>
            <input
              id="company" name="company" type="text" placeholder="Acme Inc." autocomplete="organization"
              class="w-full rounded-xl border border-[#301B69]/15 px-4 py-2.5 text-sm text-[#301B69] outline-none placeholder:text-[#301B69]/30 focus:ring-2 focus:ring-[#301B69]/20 focus:border-[#301B69]/40 transition"
            />
            <p class="text-xs text-red-600 hidden" data-error="company"></p>
          </div>

          <div class="flex flex-col gap-1">
            <label class="text-xs font-medium text-[#301B69]/70" for="phone">Phone <span class="text-red-500">*</span></label>
            <input
              id="phone" name="phone" type="tel" placeholder="+91 98765 43210" autocomplete="tel"
              class="w-full rounded-xl border border-[#301B69]/15 px-4 py-2.5 text-sm text-[#301B69] outline-none placeholder:text-[#301B69]/30 focus:ring-2 focus:ring-[#301B69]/20 focus:border-[#301B69]/40 transition"
            />
            <p class="text-xs text-red-600 hidden" data-error="phone"></p>
          </div>

          <div class="flex flex-col gap-1">
            <label class="text-xs font-medium text-[#301B69]/70" for="category">
              What are you looking to build? <span class="text-red-500">*</span>
            </label>
            <select
              id="category" name="category"
              class="w-full rounded-xl border border-[#301B69]/15 px-4 py-2.5 text-sm text-[#301B69] outline-none bg-white appearance-none focus:ring-2 focus:ring-[#301B69]/20 focus:border-[#301B69]/40 transition cursor-pointer"
            >
              <option value="" disabled selected>Select a category…</option>
              <option value="Customer Support">Customer Support</option>
              <option value="E-commerce">E-commerce</option>
              <option value="HR & Internal Tools">HR &amp; Internal Tools</option>
              <option value="Sales & Lead Generation">Sales &amp; Lead Generation</option>
              <option value="Healthcare">Healthcare</option>
              <option value="Education">Education</option>
              <option value="Real Estate">Real Estate</option>
              <option value="Other">Other</option>
            </select>
            <p class="text-xs text-red-600 hidden" data-error="category"></p>
          </div>

          <div class="flex flex-col gap-1">
            <label class="text-xs font-medium text-[#301B69]/70" for="message">
              What do you want to use Agenvik for?
            </label>
            <textarea
              id="message" name="message" rows="4"
              placeholder="E.g. customer support bot for our e-commerce store, internal HR FAQ assistant..."
              class="w-full rounded-xl border border-[#301B69]/15 px-4 py-2.5 text-sm text-[#301B69] outline-none placeholder:text-[#301B69]/30 focus:ring-2 focus:ring-[#301B69]/20 focus:border-[#301B69]/40 transition resize-none"
            ></textarea>
          </div>

          <p id="server-error" class="text-sm text-red-600 hidden"></p>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 bg-[#301B69] text-white rounded-xl text-sm font-medium hover:opacity-90 transition disabled:opacity-60"
          >
            Request a Demo →
          </button>

          {recaptchaSiteKey && (
            <p class="text-center text-xs text-[#301B69]/40">
              Protected by reCAPTCHA —{' '}
              <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="underline hover:text-[#301B69]/60">Privacy</a>
              {' '}&{' '}
              <a href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer" class="underline hover:text-[#301B69]/60">Terms</a>
            </p>
          )}
        </form>
        </div>
      </div>

    </div><!-- /grid -->
  </main>
  <Footer />
</Layout>

{recaptchaSiteKey && (
  <script
    src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`}
    async
    defer
  ></script>
)}

<script define:vars={{ apiBase, recaptchaSiteKey }}>
  const form = document.getElementById('demo-form');
  const submitBtn = document.getElementById('submit-btn');
  const serverError = document.getElementById('server-error');
  const formState = document.getElementById('form-state');
  const successState = document.getElementById('success-state');

  function showError(field, msg) {
    const el = form.querySelector(`[data-error="${field}"]`);
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
    const input = form.elements[field];
    if (input) input.classList.add('border-red-400');
  }

  function clearErrors() {
    form.querySelectorAll('[data-error]').forEach((el) => {
      el.classList.add('hidden');
      el.textContent = '';
    });
    form.querySelectorAll('input, select, textarea').forEach((el) => {
      el.classList.remove('border-red-400');
    });
    serverError.classList.add('hidden');
    serverError.textContent = '';
  }

  function validate(data) {
    const errors = {};
    if (!data.name.trim()) errors.name = 'Name is required';
    if (!data.email.trim()) errors.email = 'Email is required';
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email))
      errors.email = 'Enter a valid email';
    if (!data.company.trim()) errors.company = 'Company is required';
    if (!data.phone.trim()) errors.phone = 'Phone number is required';
    if (!data.category) errors.category = 'Please select a category';
    return errors;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();

    const fd = new FormData(form);
    const data = {
      name: fd.get('name') || '',
      email: fd.get('email') || '',
      company: fd.get('company') || '',
      phone: fd.get('phone') || '',
      category: fd.get('category') || '',
      message: fd.get('message') || '',
    };

    const errors = validate(data);
    if (Object.keys(errors).length > 0) {
      Object.entries(errors).forEach(([k, v]) => showError(k, v));
      window.amplitude?.track('Demo Request Failed', {
        error_reason: 'validation',
        fields_with_errors: Object.keys(errors),
      });
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting…';

    try {
      let captchaToken = '';
      if (recaptchaSiteKey && window.grecaptcha) {
        captchaToken = await new Promise((resolve) =>
          window.grecaptcha.ready(async () => {
            resolve(await window.grecaptcha.execute(recaptchaSiteKey, { action: 'book_demo' }));
          })
        );
      }

      const payload = {
        name: data.name.trim(),
        email: data.email.trim(),
        company: data.company.trim(),
        category: data.category,
        captchaToken,
      };
      if (data.phone.trim()) payload.phone = data.phone.trim();
      if (data.message.trim()) payload.message = data.message.trim();

      const res = await fetch(`${apiBase}/demo`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!res.ok) throw new Error('Something went wrong. Please try again.');

      window.amplitude?.track('Demo Requested', {
        category: data.category,
        company: data.company.trim(),
      });

      formState.classList.add('hidden');
      successState.classList.remove('hidden');
    } catch (err) {
      serverError.textContent = err instanceof Error ? err.message : 'Something went wrong.';
      serverError.classList.remove('hidden');
      window.amplitude?.track('Demo Request Failed', {
        error_reason: 'api_error',
        fields_with_errors: [],
      });
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Request a Demo →';
    }
  });
</script>
