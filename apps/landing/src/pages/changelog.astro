---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const siteURL = 'https://agenvik.com';
const pageURL = `${siteURL}/changelog`;

const releases = [
  {
    version: '0.6.0',
    date: 'May 26, 2026',
    isoDate: '2026-05-26',
    isLatest: true,
    entries: [
      {
        type: 'new',
        title: 'PDF knowledge source',
        description: 'Upload PDF files directly as knowledge sources. Your agent extracts and indexes the text automatically — supports multi-page documents up to 200,000 characters.',
      },
      {
        type: 'new',
        title: 'Website URL knowledge source',
        description: 'Point your agent at any public webpage. Paste the URL, preview the extracted content, and save — no manual copy-pasting required.',
      },
      {
        type: 'new',
        title: 'Training reminder',
        description: 'A guided prompt appears after you add your first knowledge source, so you know to hit Train before going live.',
      },
      {
        type: 'improved',
        title: 'Conversation filter',
        description: 'Filter your conversation list in the dashboard to quickly find what you need.',
      },
    ],
  },
  {
    version: '0.1.0',
    date: 'May 20, 2026',
    isoDate: '2026-05-20',
    isLatest: false,
    entries: [
      {
        type: 'new',
        title: 'Agenvik launches',
        description: 'Create AI agents from your own knowledge, deploy them on your website, WhatsApp, or Slack — no code required.',
      },
    ],
  },
  {
    version: '0.5.0',
    date: 'May 8, 2026',
    isoDate: '2026-05-08',
    isLatest: false,
    entries: [
      {
        type: 'new',
        title: 'Dark mode',
        description: 'The dashboard now fully supports dark mode. Toggle it from your account settings.',
      },
      {
        type: 'new',
        title: 'Notification sound',
        description: 'The chat widget plays a soft tone when a new message arrives. Users can mute/unmute — preference is saved across sessions.',
      },
      {
        type: 'new',
        title: 'Suggestion questions',
        description: 'Configure up to four suggested questions that appear in the chat widget before the first message. Helps visitors know what to ask.',
      },
      {
        type: 'new',
        title: 'Bubble color customization',
        description: 'Set a custom color for the chat bubble to match your brand, per agent.',
      },
      {
        type: 'improved',
        title: 'Rich text editor',
        description: 'The knowledge source text editor has been upgraded with a cleaner toolbar, better formatting, and improved paste behavior.',
      },
    ],
  },
  {
    version: '0.4.0',
    date: 'April 21, 2026',
    isoDate: '2026-04-21',
    isLatest: false,
    entries: [
      {
        type: 'new',
        title: 'Lead generation',
        description: 'Your agent can now collect visitor contact details through natural conversation — name, email, phone. Leads appear in your dashboard and can be exported.',
      },
      {
        type: 'new',
        title: 'Live billing plans',
        description: 'Subscription management is now live — upgrade, downgrade, or cancel directly from the dashboard.',
      },
    ],
  },
  {
    version: '0.2.0',
    date: 'April 2026',
    isoDate: '2026-04-01',
    isLatest: false,
    entries: [
      {
        type: 'improved',
        title: 'Chat UX polish',
        description: 'Messages auto-scroll to the latest reply, a New Chat button lets visitors start fresh, and keyboard navigation is fully accessible.',
      },
    ],
  },
];

const typeConfig: Record<string, { label: string; classes: string }> = {
  new:      { label: 'New',      classes: 'bg-[#301B69]/10 text-[#301B69]' },
  improved: { label: 'Improved', classes: 'bg-violet-100 text-violet-700' },
  fixed:    { label: 'Fixed',    classes: 'bg-emerald-50 text-emerald-700' },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageURL,
  url: pageURL,
  name: 'Changelog — Agenvik',
  description: 'Every improvement, new feature, and fix shipped to Agenvik — your AI agent platform.',
  isPartOf: { '@id': `${siteURL}/#website` },
  about: { '@id': `${siteURL}/#organization` },
  publisher: { '@id': `${siteURL}/#organization` },
  dateModified: '2026-05-26',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
      { '@type': 'ListItem', position: 2, name: 'Changelog', item: pageURL },
    ],
  },
};
---

<Layout
  title="Changelog — Agenvik"
  description="Every improvement, new feature, and fix shipped to Agenvik — your AI agent platform."
  jsonLd={jsonLd}
>
  <main id="main-content" class="relative w-full bg-white pt-[68px]">

    <!-- Grid + radial background -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background-image: linear-gradient(rgba(48,27,105,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(48,27,105,0.07) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, white 0%, white 12%, transparent 28%); -webkit-mask-image: linear-gradient(to bottom, white 0%, white 12%, transparent 28%);"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_60%_35%_at_50%_0%,rgba(124,58,237,0.08),transparent)] pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 pt-14 pb-24">

      <!-- Page header -->
      <div class="text-center mb-16">
        <p class="text-xs font-semibold uppercase tracking-widest text-[#301B69]/50 mb-3">What's new</p>
        <h1 class="text-4xl md:text-5xl font-bold text-[#301B69] mb-4">Changelog</h1>
        <p id="page-description" class="text-[#301B69]/60 text-lg max-w-xl mx-auto">
          Every feature, improvement, and fix we've shipped — most recent first.
        </p>
      </div>

      <!-- Timeline -->
      <div class="relative">

        <!--
          3-column CSS grid: [160px label] [40px dot column] [1fr content]
          Vertical line is centered in the dot column: left = 160 + 20 = 180px
        -->
        <div
          class="hidden md:block absolute top-0 bottom-0 w-px bg-[#301B69]/10"
          style="left: 180px"
          aria-hidden="true"
        ></div>

        <div class="space-y-14">
          {releases.map((release) => (
            <div class="group">

              <!-- Mobile: stacked layout -->
              <div class="md:hidden mb-3 flex items-center gap-3">
                <span class:list={[
                  'inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full',
                  release.isLatest ? 'bg-[#301B69] text-white' : 'bg-[#301B69]/8 text-[#301B69]'
                ]}>
                  {release.isLatest && <span class="w-1.5 h-1.5 rounded-full bg-white/80 inline-block" aria-hidden="true"></span>}
                  v{release.version}
                  {release.isLatest && <span class="font-normal opacity-70">latest</span>}
                </span>
                <time datetime={release.isoDate} class="text-xs text-[#301B69]/45">{release.date}</time>
              </div>

              <!-- Desktop: 3-column grid -->
              <div class="hidden md:grid" style="grid-template-columns: 160px 40px 1fr">

                <!-- Col 1: version + date, right-aligned -->
                <div class="text-right pr-4 pt-1">
                  <span class:list={[
                    'inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full',
                    release.isLatest ? 'bg-[#301B69] text-white' : 'bg-[#301B69]/8 text-[#301B69]'
                  ]}>
                    {release.isLatest && <span class="w-1.5 h-1.5 rounded-full bg-white/80 inline-block" aria-hidden="true"></span>}
                    v{release.version}
                    {release.isLatest && <span class="font-normal opacity-70">latest</span>}
                  </span>
                  <time datetime={release.isoDate} class="block text-xs text-[#301B69]/45 mt-1.5">{release.date}</time>
                </div>

                <!-- Col 2: dot, centered on the line -->
                <div class="flex justify-center pt-[7px]" aria-hidden="true">
                  <div class:list={[
                    'w-[10px] h-[10px] rounded-full border-2 flex-shrink-0',
                    release.isLatest
                      ? 'bg-[#301B69] border-[#301B69]'
                      : 'bg-white border-[#301B69]/30 group-hover:border-[#301B69]/60 transition-colors'
                  ]}></div>
                </div>

                <!-- Col 3: entries -->
                <div class="pl-4 space-y-3">
                  {release.entries.map((entry) => {
                    const tc = typeConfig[entry.type] ?? typeConfig.new;
                    return (
                      <div class="bg-white rounded-2xl border border-[#301B69]/8 p-5 shadow-sm hover:shadow-md hover:border-[#301B69]/15 transition-all">
                        <div class="flex items-start gap-3">
                          <span class:list={['inline-block text-[10px] font-semibold px-2 py-0.5 rounded-full mt-0.5 flex-shrink-0 uppercase tracking-wide', tc.classes]}>
                            {tc.label}
                          </span>
                          <div>
                            <h2 class="text-sm font-semibold text-[#301B69] leading-snug">{entry.title}</h2>
                            <p class="text-sm text-[#301B69]/60 mt-1 leading-relaxed">{entry.description}</p>
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>

              </div>

              <!-- Mobile: entries -->
              <div class="md:hidden space-y-3">
                {release.entries.map((entry) => {
                  const tc = typeConfig[entry.type] ?? typeConfig.new;
                  return (
                    <div class="bg-white rounded-2xl border border-[#301B69]/8 p-5 shadow-sm">
                      <div class="flex items-start gap-3">
                        <span class:list={['inline-block text-[10px] font-semibold px-2 py-0.5 rounded-full mt-0.5 flex-shrink-0 uppercase tracking-wide', tc.classes]}>
                          {tc.label}
                        </span>
                        <div>
                          <h2 class="text-sm font-semibold text-[#301B69] leading-snug">{entry.title}</h2>
                          <p class="text-sm text-[#301B69]/60 mt-1 leading-relaxed">{entry.description}</p>
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>

            </div>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-20 text-center">
        <p class="text-sm text-[#301B69]/50 mb-4">Stay up to date — follow us for the latest releases.</p>
        <div class="flex items-center justify-center gap-3">
          <a
            href="https://x.com/agenvik"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-[#301B69]/20 text-sm text-[#301B69] hover:bg-[#301B69]/5 transition-colors"
            aria-label="Follow Agenvik on X / Twitter"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            @agenvik
          </a>
          <a
            href="https://linkedin.com/company/agenvik"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-[#301B69]/20 text-sm text-[#301B69] hover:bg-[#301B69]/5 transition-colors"
            aria-label="Follow Agenvik on LinkedIn"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 23.2 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
        </div>
      </div>

    </div>
  </main>
  <Footer />
</Layout>
