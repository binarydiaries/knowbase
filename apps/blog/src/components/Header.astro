---
const base = import.meta.env.BASE_URL;
---

<header class="px-6 py-4 border-b border-[#301B69]/10 bg-white/80 backdrop-blur sticky top-0 z-50">
  <div class="max-w-6xl mx-auto flex items-center justify-between">
    <a href="https://agenvik.com" aria-label="Agenvik home">
      <img src={`${base}/logo.svg`} alt="Agenvik" class="h-7 w-auto" />
    </a>

    <nav aria-label="Blog navigation" class="hidden md:flex gap-6 text-sm text-[#301B69]/70">
      <a href="https://agenvik.com/#features" class="hover:text-[#301B69] transition">Features</a>
      <a href="https://agenvik.com/#pricing" class="hover:text-[#301B69] transition">Pricing</a>
      <a href="https://agenvik.com/#faq" class="hover:text-[#301B69] transition">FAQ</a>
      <a href={base} class="text-[#301B69] font-medium transition">Blog</a>
    </nav>

    <a
      href="https://app.agenvik.com"
      class="bg-[#301B69] text-white px-4 py-2 rounded-lg text-sm hover:opacity-90 transition"
    >
      Get Started
    </a>
  </div>
</header>
