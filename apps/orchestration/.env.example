# Same PostgreSQL connection as apps/backend
DATABASE_URL=postgresql://user:password@localhost:5432/knowbase

# OpenAI API key (same as backend)
OPENAI_API_KEY=sk-...

# Backend URL — used by save-lead action to trigger email notifications
BACKEND_URL=http://localhost:3000

# Internal secret for backend webhook calls from orchestration
INTERNAL_SECRET=change-me

# LangGraph server port (default: 2024)
# PORT=2024
