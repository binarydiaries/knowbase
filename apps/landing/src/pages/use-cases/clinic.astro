---
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import pricingBgSrc from '../../assets/images/pricing-bg.png';
import { ChevronDown } from '@lucide/astro';

const appURL = import.meta.env.PUBLIC_APP_URL || 'https://app.agenvik.com';
const pricingBg = await getImage({ src: pricingBgSrc, format: 'webp', quality: 80 });

const siteURL = 'https://agenvik.com';
const pageURL = `${siteURL}/use-cases/clinic`;

const faqs = [
  {
    q: 'Is patient data safe with an AI agent at a clinic?',
    a: 'The Agenvik agent only knows what you upload — general clinic information like hours, services, and billing basics. No patient records, medical history, or personal data ever enters the system. Agenvik cannot access your clinic management software.',
  },
  {
    q: 'Can an AI agent book clinic appointments automatically?',
    a: 'Right now Agenvik can share your booking link (Calendly, Practo, your own form) or collect the patient\'s details for a callback. Direct calendar integration — where Agenvik books the appointment itself — is on the roadmap.',
  },
  {
    q: 'What happens if a patient asks the AI agent a medical question?',
    a: 'Agenvik is scoped to administrative queries only. If a patient asks something clinical ("is this symptom serious?", "can I take this medication?"), Agenvik responds: "For medical questions, please speak with one of our doctors. Call us at [number] or visit during clinic hours." It never attempts to answer clinical questions.',
  },
  {
    q: 'What languages does Agenvik support for clinic patient queries?',
    a: 'Agenvik responds in whatever language the patient writes in, as long as the relevant information is in your knowledge base. Upload your FAQ in the languages your patients use most.',
  },
  {
    q: 'How long does it take to set up Agenvik for a clinic?',
    a: 'Most clinics are live within an hour. Upload your documents, deploy the widget, connect WhatsApp. The Agenvik agent starts handling queries immediately — no engineering required.',
  },
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageURL,
  url: pageURL,
  name: 'AI Agent for Clinics & Hospitals — Handle Patient FAQs 24/7 | Agenvik',
  description:
    'Stop tying up your front desk with calls about hours, services, and insurance. Agenvik answers common patient questions 24/7 — on your website and WhatsApp — no clinical advice, just accurate admin info.',
  isPartOf: { '@id': `${siteURL}/#website` },
  about: { '@id': `${siteURL}/#organization` },
  publisher: { '@id': `${siteURL}/#organization` },
  dateModified: '2025-05-23',
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['#page-description', '#solution-heading', '#clinical-boundary'],
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
      { '@type': 'ListItem', position: 2, name: 'Use Cases', item: `${siteURL}/use-cases` },
      { '@type': 'ListItem', position: 3, name: 'Clinics & Hospitals', item: pageURL },
    ],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to set up an AI agent for clinic patient queries using Agenvik',
  description: 'Set up Agenvik to automatically handle patient enquiries on your website and WhatsApp in 4 steps — no coding required.',
  totalTime: 'PT60M',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Upload your clinic information',
      text: 'Drop in your FAQ document, services list, insurance and billing info, and doctor directory. Standard Word or PDF format works. No special formatting needed.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Deploy on your website and WhatsApp',
      text: 'Add the chat widget to your website in 2 minutes with one line of code. Connect your WhatsApp Business number in about 15 minutes. Both channels run the same agent simultaneously.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Patients get answers instantly',
      text: 'Whether it\'s 8am or 11pm, patients asking about your hours, services, or insurance get an accurate, immediate answer — sourced directly from the information you provided.',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Your team handles what matters',
      text: 'The agent logs every conversation. Your staff reviews the log daily, spots any gaps in the knowledge base, and handles anything the agent correctly escalated.',
    },
  ],
};
---

<Layout
  title="AI Agent for Clinics & Hospitals — Handle Patient FAQs 24/7 | Agenvik"
  description="Stop tying up your front desk with calls about hours, services, and insurance. Agenvik answers common patient questions 24/7 — on your website and WhatsApp — no clinical advice, just accurate admin info."
  activePage="use-cases"
  jsonLd={[webPageSchema, faqSchema, howToSchema]}
>
  <main id="main-content">

    <!-- ── SECTION 1: HERO ── -->
    <section
      aria-label="Hero"
      class="relative w-full overflow-hidden bg-white pt-[68px]"
    >
      <!-- Grid background -->
      <div
        class="absolute inset-0 pointer-events-none"
        style="background-image: linear-gradient(rgba(48,27,105,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(48,27,105,0.07) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, white 0%, white 55%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, white 0%, white 55%, transparent 100%);"
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_50%_0%,rgba(124,58,237,0.08),transparent)] pointer-events-none"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 max-w-6xl mx-auto px-6 pt-14 pb-20">
        <div class="grid md:grid-cols-2 gap-12 items-center">

          <!-- Left: copy -->
          <div>
            <div aria-hidden="true" class="inline-flex items-center gap-1.5 px-4 py-1 text-xs font-semibold rounded-full bg-[#301B69]/8 text-[#301B69] mb-6 tracking-widest uppercase">
              <span>✦</span> Clinics & Hospitals
            </div>

            <h1 class="text-4xl md:text-5xl leading-tight tracking-tight text-[#301B69] mb-6">
              <span class="block font-normal">Your receptionist answers 60 calls a day.</span>
              <span class="block font-bold">Half of them ask the same things.</span>
            </h1>

            <p id="page-description" class="text-[#301B69]/70 text-base md:text-lg mb-6 leading-relaxed">
              Agenvik is an AI agent for clinics and hospitals that handles patient enquiries on your website and WhatsApp — hours, services, insurance, booking info — instantly, 24/7. Your front desk focuses on the patients in front of them.
            </p>

            <!-- Trust chips -->
            <div class="flex flex-wrap gap-2 mb-8">
              {[
                'Answers in under 3 seconds',
                'Website & WhatsApp',
                'No clinical advice — ever',
                'Free to start',
              ].map((chip) => (
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#301B69]/6 text-[#301B69]/70 text-xs font-medium">
                  <svg class="w-3 h-3 text-[#301B69]/40 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  {chip}
                </span>
              ))}
            </div>

            <div class="flex flex-wrap gap-4 items-center mb-6">
              <a
                href={appURL}
                class="px-8 py-3.5 bg-[#301B69] text-white rounded-xl font-semibold hover:opacity-90 transition-opacity"
              >
                Start free →
              </a>
              <a
                href="#how-it-works"
                class="px-8 py-3.5 text-[#301B69] bg-white rounded-xl border border-[#301B69]/20 hover:bg-[#301B69]/5 transition-colors"
              >
                See how it works ↓
              </a>
            </div>

            <p class="text-sm text-[#301B69]/50">Free plan · No credit card required · Live in under an hour</p>
          </div>

          <!-- Right: chat widget mockup -->
          <div aria-hidden="true" class="flex justify-center md:justify-end">
            <div class="w-full max-w-[340px] rounded-2xl overflow-hidden shadow-2xl border border-black/8">

              <!-- Widget header -->
              <div class="bg-[#301B69] px-4 py-3 flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-white/15 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-white text-sm font-semibold leading-none mb-0.5">Aria · Your clinic agent</p>
                  <div class="flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-400 flex-shrink-0"></span>
                    <p class="text-white/60 text-xs">Online · instant replies</p>
                  </div>
                </div>
              </div>

              <!-- Chat thread -->
              <div class="bg-gray-50 px-3 py-3 space-y-2">

                <!-- Agent greeting -->
                <div class="flex justify-start">
                  <div class="bg-white rounded-t-xl rounded-br-xl rounded-bl-sm px-3 py-2 max-w-[85%] shadow-sm border border-gray-100">
                    <p class="text-[11px] text-gray-800 leading-snug">Hi! I'm Aria. I can answer questions about our services, hours, insurance, and more. How can I help?</p>
                    <p class="text-[9px] text-gray-400 mt-1 text-right">9:02 AM</p>
                  </div>
                </div>

                <!-- Patient Q1 -->
                <div class="flex justify-end">
                  <div class="bg-[#301B69] rounded-t-xl rounded-bl-xl rounded-br-sm px-3 py-2 max-w-[80%] shadow-sm">
                    <p class="text-[11px] text-white leading-snug">Are you open this Sunday?</p>
                    <p class="text-[9px] text-white/50 mt-1 text-right">9:03 AM</p>
                  </div>
                </div>

                <!-- Agent reply Q1 -->
                <div class="flex justify-start">
                  <div class="bg-white rounded-t-xl rounded-br-xl rounded-bl-sm px-3 py-2 max-w-[88%] shadow-sm border border-gray-100">
                    <p class="text-[11px] text-gray-800 leading-snug">Yes! We're open Sundays from 9am to 1pm. Walk-ins are welcome until 12pm.</p>
                    <div class="flex items-center gap-1 mt-1.5 border-t border-gray-100 pt-1">
                      <svg class="w-2.5 h-2.5 text-[#301B69]/50 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14 2z"/></svg>
                      <p class="text-[9px] text-[#301B69]/60">Clinic Hours.pdf</p>
                    </div>
                    <p class="text-[9px] text-gray-400 mt-0.5 text-right">9:03 AM</p>
                  </div>
                </div>

                <!-- Patient Q2 -->
                <div class="flex justify-end">
                  <div class="bg-[#301B69] rounded-t-xl rounded-bl-xl rounded-br-sm px-3 py-2 max-w-[80%] shadow-sm">
                    <p class="text-[11px] text-white leading-snug">Do you accept Star Health insurance?</p>
                    <p class="text-[9px] text-white/50 mt-1 text-right">9:04 AM</p>
                  </div>
                </div>

                <!-- Agent reply Q2 -->
                <div class="flex justify-start">
                  <div class="bg-white rounded-t-xl rounded-br-xl rounded-bl-sm px-3 py-2 max-w-[88%] shadow-sm border border-gray-100">
                    <p class="text-[11px] text-gray-800 leading-snug">Yes, we accept Star Health, HDFC Ergo, and Niva Bupa among others. For billing queries call our desk directly.</p>
                    <div class="flex items-center gap-1 mt-1.5 border-t border-gray-100 pt-1">
                      <svg class="w-2.5 h-2.5 text-[#301B69]/50 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14 2z"/></svg>
                      <p class="text-[9px] text-[#301B69]/60">Insurance List.pdf</p>
                    </div>
                    <p class="text-[9px] text-gray-400 mt-0.5 text-right">9:04 AM</p>
                  </div>
                </div>

                <!-- Patient Q3 — booking request (flagged) -->
                <div class="flex justify-end">
                  <div class="bg-[#301B69] rounded-t-xl rounded-bl-xl rounded-br-sm px-3 py-2 max-w-[80%] shadow-sm border-r-[3px] border-[#B07CD1]">
                    <p class="text-[11px] text-white leading-snug">I'd like to book with Dr. Sharma this week.</p>
                    <p class="text-[9px] text-white/50 mt-1 text-right">9:05 AM</p>
                  </div>
                </div>

                <!-- System pill -->
                <div class="flex justify-center">
                  <span class="text-[9px] text-white bg-[#301B69]/80 px-3 py-1 rounded-full shadow-sm">
                    📋 Flagged — booking request for staff
                  </span>
                </div>
              </div>

              <!-- Footer bar -->
              <div class="bg-[#F0F0F0] px-4 py-2 flex items-center justify-between">
                <p class="text-[10px] text-gray-500">Aria handled this · 1 item needs you</p>
                <span class="text-[9px] font-semibold text-[#301B69] bg-[#301B69]/8 px-2 py-0.5 rounded-full">Review →</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ── SECTION 2: THE PROBLEM ── -->
    <section aria-labelledby="problem-heading" class="px-6 pt-16">
      <div class="max-w-6xl mx-auto">
        <div class="relative rounded-3xl p-10 md:p-16 overflow-hidden bg-[#1a0f3d]">
          <div class="absolute -top-32 right-0 w-[500px] h-[400px] bg-[radial-gradient(ellipse_at_center,rgba(48,27,105,0.4),transparent_70%)]" aria-hidden="true"></div>
          <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-[radial-gradient(ellipse_at_center,rgba(176,124,209,0.15),transparent_70%)]" aria-hidden="true"></div>

          <div class="relative z-10 text-center mb-12">
            <h2 id="problem-heading" class="text-3xl md:text-4xl font-bold text-white leading-tight">
              What your front desk is actually doing all day
            </h2>
          </div>

          <div class="relative z-10 grid md:grid-cols-3 gap-8">
            <div class="text-center md:text-left">
              <p class="text-5xl md:text-6xl font-bold text-white mb-2">50%+</p>
              <p class="text-sm font-semibold text-[#B07CD1] uppercase tracking-widest mb-3">Of calls are about hours, services, or insurance</p>
              <p class="text-white/60 text-sm leading-relaxed">"Are you open on Sunday?" "Do you see children?" "Do you accept [insurance]?" These questions have definitive answers. Your staff shouldn't need to answer them 40 times a day.</p>
            </div>
            <div class="text-center md:text-left">
              <p class="text-5xl md:text-6xl font-bold text-white mb-2">10pm</p>
              <p class="text-sm font-semibold text-[#B07CD1] uppercase tracking-widest mb-3">When patients research and can't reach you</p>
              <p class="text-white/60 text-sm leading-relaxed">A patient checking if you take walk-ins at night can't get an answer. They book elsewhere, or show up unannounced tomorrow. The information was on your website — but buried.</p>
            </div>
            <div class="text-center md:text-left">
              <p class="text-5xl md:text-6xl font-bold text-white mb-2">Every rotation</p>
              <p class="text-sm font-semibold text-[#B07CD1] uppercase tracking-widest mb-3">New staff relearning the same answers</p>
              <p class="text-white/60 text-sm leading-relaxed">Every time a new receptionist joins, they spend their first week asking colleagues basic questions about services. That knowledge should be findable — not memorised.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── SECTION 3: THE SOLUTION ── -->
    <section aria-labelledby="solution-heading" class="px-6 pt-16">
      <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-start">
          <div>
            <h2 id="solution-heading" class="text-3xl md:text-4xl font-bold text-[#301B69] mb-5 leading-tight">
              An AI agent for clinics — handles the admin layer so your team handles the human layer
            </h2>
            <p class="text-[#301B69]/70 text-base leading-relaxed mb-3">
              Upload your clinic's FAQ, services list, doctor profiles, insurance information, and standard procedures. Agenvik answers inbound questions instantly — on your website and WhatsApp — 24 hours a day. Anything clinical, complex, or requiring a real decision routes straight to your team.
            </p>
            <p id="clinical-boundary" class="text-[#301B69]/60 text-sm leading-relaxed mb-5 bg-[#301B69]/4 rounded-xl px-4 py-3 border border-[#301B69]/8">
              <strong class="text-[#301B69]/80 font-semibold">Important:</strong> Agenvik handles administrative and informational queries only. It never provides clinical advice, diagnoses, or anything that requires a licensed professional. Patient records never touch the system.
            </p>
            <div class="flex flex-wrap gap-4 text-sm mb-8">
              <a href="/features" class="text-[#301B69] font-medium hover:opacity-70 transition-opacity underline underline-offset-2 decoration-[#301B69]/30">See all features →</a>
              <a href="/pricing" class="text-[#301B69] font-medium hover:opacity-70 transition-opacity underline underline-offset-2 decoration-[#301B69]/30">View pricing →</a>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-4">
            <!-- Handles -->
            <div class="rounded-2xl border border-[#301B69]/10 bg-[#301B69]/3 p-6">
              <div class="flex items-center gap-2 mb-4">
                <div class="w-6 h-6 rounded-full bg-[#301B69] flex items-center justify-center flex-shrink-0">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <h3 class="font-semibold text-[#301B69] text-sm uppercase tracking-wide">What it handles</h3>
              </div>
              <ul class="space-y-2">
                {[
                  'Clinic hours, location, and parking',
                  'Services offered and which doctor or department handles what',
                  'Insurance providers accepted and basic billing information',
                  'Appointment booking process and typical wait times',
                  'Walk-in policy and emergency contact routing',
                  'Languages spoken at the clinic',
                ].map((item) => (
                  <li class="flex items-start gap-2.5 text-sm text-[#301B69]/70">
                    <svg class="w-4 h-4 text-[#301B69]/40 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Hands off -->
            <div class="rounded-2xl border border-[#B07CD1]/20 bg-[#B07CD1]/5 p-6">
              <div class="flex items-center gap-2 mb-4">
                <div class="w-6 h-6 rounded-full bg-[#B07CD1] flex items-center justify-center flex-shrink-0">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14"/></svg>
                </div>
                <h3 class="font-semibold text-[#301B69] text-sm uppercase tracking-wide">What it hands off to your team</h3>
              </div>
              <ul class="space-y-2">
                {[
                  'Any clinical question (symptoms, treatment, medication) — routes to on-call contact',
                  'Appointment booking itself — shares your booking link or collects details for callback',
                  'Complaints or urgent patient needs — routes to a specific staff member',
                ].map((item) => (
                  <li class="flex items-start gap-2.5 text-sm text-[#301B69]/70">
                    <svg class="w-4 h-4 text-[#B07CD1] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/></svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── SECTION 4: HOW IT WORKS ── -->
    <section id="how-it-works" aria-labelledby="howitworks-heading" class="px-6 pt-16">
      <div class="max-w-6xl mx-auto">
        <div
          class="relative rounded-3xl p-10 md:p-14 overflow-hidden bg-cover bg-center"
          style={`background-image: url(${pricingBg.src})`}
        >
          <div class="absolute inset-0 bg-white/55 backdrop-blur-[2px]" aria-hidden="true"></div>

          <div class="relative z-10 text-center mb-12">
            <div aria-hidden="true" class="inline-flex items-center gap-1.5 px-4 py-1 text-xs font-semibold rounded-full bg-[#301B69]/8 text-[#301B69] mb-4 uppercase tracking-widest">
              <span>✦</span> How It Works
            </div>
            <h2 id="howitworks-heading" class="text-3xl md:text-4xl font-bold text-[#301B69]">
              Set it up once. Your patients get answers around the clock.
            </h2>
          </div>

          <ol class="relative z-10 grid md:grid-cols-2 gap-6 list-none">
            {[
              {
                step: '1',
                title: 'Upload your clinic information',
                body: 'Drop in your FAQ document, services list, insurance and billing info, and doctor directory. Standard Word or PDF format works. No special formatting needed.',
              },
              {
                step: '2',
                title: 'Deploy on your website and WhatsApp',
                body: 'Add the chat widget to your website in 2 minutes with one line of code. Connect your WhatsApp Business number in about 15 minutes. Both channels run the same agent simultaneously.',
              },
              {
                step: '3',
                title: 'Patients get answers instantly',
                body: "Whether it's 8am or 11pm, patients asking about your hours, services, or insurance get an accurate, immediate answer — sourced directly from the information you provided.",
              },
              {
                step: '4',
                title: 'Your team handles what matters',
                body: 'The agent logs every conversation. Your staff reviews the log daily, spots any gaps in the knowledge base, and handles anything the agent correctly escalated.',
              },
            ].map(({ step, title, body }) => (
              <li class="rounded-2xl bg-white/90 border border-[#301B69]/10 p-6 flex flex-col gap-4">
                <div class="flex items-center gap-3">
                  <span class="w-8 h-8 rounded-full bg-[#301B69] text-white text-sm font-bold flex items-center justify-center flex-shrink-0">
                    {step}
                  </span>
                  <h3 class="font-semibold text-[#301B69]">{title}</h3>
                </div>
                <p class="text-sm text-[#301B69]/70 leading-relaxed">{body}</p>
              </li>
            ))}
          </ol>

          <div class="relative z-10 mt-8 flex flex-col md:flex-row items-center justify-between gap-6 bg-white/80 rounded-2xl p-6 border border-[#301B69]/10">
            <div>
              <h3 class="text-base font-semibold text-[#301B69] mb-1">Live in under an hour — free to start</h3>
              <p class="text-sm text-[#301B69]/60">No setup fees. No code. No credit card required.</p>
            </div>
            <a
              href={appURL}
              class="bg-[#301B69] text-white px-6 py-3 rounded-xl text-sm font-semibold hover:opacity-90 transition-opacity flex-shrink-0"
            >
              Build your clinic agent →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── SECTION 5: FAQ ── -->
    <section aria-labelledby="faq-heading" class="px-6 pt-16">
      <div class="max-w-6xl mx-auto">
        <div class="relative rounded-3xl p-10 md:p-14 overflow-hidden bg-[#1a0f3d]">
          <div class="absolute -top-32 right-0 w-[500px] h-[400px] bg-[radial-gradient(ellipse_at_center,rgba(48,27,105,0.4),transparent_70%)]" aria-hidden="true"></div>

          <div class="relative z-10 text-center mb-10">
            <h2 id="faq-heading" class="text-3xl md:text-4xl font-bold text-white mb-3">
              Questions clinic owners ask
            </h2>
          </div>

          <div class="relative z-10 space-y-4 max-w-3xl mx-auto">
            {faqs.map(({ q, a }) => (
              <div class="rounded-xl border border-white/10 bg-white/5 overflow-hidden">
                <details class="group">
                  <summary class="flex w-full justify-between items-center text-left cursor-pointer p-5 list-none [&::-webkit-details-marker]:hidden">
                    <span class="text-sm md:text-base font-medium text-white">{q}</span>
                    <span class="w-5 h-5 text-white/60 transition-transform flex-shrink-0 group-open:rotate-180 ml-3" aria-hidden="true">
                      <ChevronDown size={20} strokeWidth={2} />
                    </span>
                  </summary>
                  <p class="px-5 pb-5 text-sm text-white/60 leading-relaxed">{a}</p>
                </details>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── SECTION 6: FINAL CTA ── -->
    <section aria-labelledby="cta-heading" class="px-6 pt-16">
      <div class="max-w-6xl mx-auto">
        <div class="relative rounded-3xl p-10 md:p-16 overflow-hidden bg-[#301B69] text-center">
          <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-[radial-gradient(ellipse_at_center,rgba(176,124,209,0.3),transparent_70%)]" aria-hidden="true"></div>

          <div class="relative z-10">
            <h2 id="cta-heading" class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight">
              Give your front desk their time back
            </h2>
            <p class="text-white/70 text-base md:text-lg mb-8 max-w-xl mx-auto">
              Free plan. Set up in under an hour. No credit card.
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4 items-center mb-6">
              <a
                href={appURL}
                class="px-8 py-3.5 bg-white text-[#301B69] rounded-xl font-semibold hover:opacity-90 transition-opacity"
              >
                Build your clinic agent →
              </a>
              <a
                href="/book-demo"
                class="px-8 py-3.5 text-white border border-white/30 rounded-xl hover:bg-white/10 transition-colors"
              >
                Book a demo instead →
              </a>
            </div>
            <p class="text-white/40 text-sm">Free plan · No credit card required · Cancel anytime · Data stays private</p>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
