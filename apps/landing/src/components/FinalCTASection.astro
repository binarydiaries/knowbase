---
const appURL = import.meta.env.PUBLIC_APP_URL || 'https://app.agenvik.com';
---
<section aria-labelledby="final-cta-heading" class="px-6 pt-16 pb-10">
  <div class="max-w-6xl mx-auto">
    <div class="relative rounded-3xl p-10 md:p-16 overflow-hidden bg-[#301B69] text-center">
      <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-[#B07CD1]/30 blur-[100px]" aria-hidden="true"></div>

      <div class="relative z-10">
        <h2 id="final-cta-heading" class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight">
          Your first agent is free.<br />Start in 10 minutes.
        </h2>

        <p class="text-white/70 text-base md:text-lg mb-8 max-w-xl mx-auto">
          No credit card. No engineering team. No complex setup. Just your documents and 10 minutes.
        </p>

        <div class="flex flex-col sm:flex-row justify-center gap-4 items-center mb-6">
          <a
            href={appURL}
            data-get-started
            data-source="final_cta"
            class="px-8 py-3.5 bg-white text-[#301B69] rounded-xl font-semibold hover:opacity-90 transition-opacity"
          >
            Start for free →
          </a>
          <a
            href="/book-demo"
            class="px-8 py-3.5 text-white border border-white/30 rounded-xl hover:bg-white/10 transition-colors"
          >
            Book a demo instead →
          </a>
        </div>

        <p class="text-white/40 text-sm">
          Free plan · No credit card required · Cancel anytime · Data stays private
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var btn = document.querySelector('[data-source="final_cta"]');
    if (btn) {
      btn.addEventListener('click', function () {
        window.amplitude?.track('Get Started Clicked', { source: 'final_cta' });
      });
    }
  });
</script>
