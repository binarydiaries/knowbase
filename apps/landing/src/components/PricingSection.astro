---
import { getImage } from 'astro:assets';
import pricingBgSrc from '../assets/images/pricing-bg.png';

const pricingBg = await getImage({ src: pricingBgSrc, format: 'webp', quality: 80 });

const plans = [
  { name: 'Free', price: '₹0/mo', desc: 'Try it out' },
  { name: 'Starter', price: '₹499/mo', desc: 'Solo builders' },
  { name: 'Growth', price: '₹1,499/mo', desc: 'Growing teams', highlight: true },
  { name: 'Pro', price: '₹3,999/mo', desc: 'High-volume businesses' },
];
---
<section id="pricing" aria-labelledby="pricing-heading" class="px-6 pt-16">
  <div class="max-w-6xl mx-auto">
    <div
      class="relative rounded-3xl p-10 md:p-14 overflow-hidden bg-cover bg-center"
      style={`background-image: url(${pricingBg.src})`}
    >
      <div class="absolute inset-0 bg-white/50 backdrop-blur-[2px]" aria-hidden="true"></div>

      <div class="relative z-10 text-center">
        <div class="inline-flex px-4 py-1 text-xs rounded-full bg-white/70 text-[#301B69] mb-4" aria-hidden="true">
          ✦ PRICING
        </div>

        <h2 id="pricing-heading" class="text-3xl md:text-4xl font-bold text-[#301B69] mb-3">
          Start free. Upgrade when you're ready.
        </h2>

        <p class="text-[#301B69]/70 mb-10 text-sm md:text-base">
          No hidden fees. No lock-in. Downgrade or cancel anytime.
        </p>

        <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10 list-none text-left">
          {plans.map((plan) => (
            <li class:list={[
              'rounded-2xl p-5 border',
              plan.highlight
                ? 'bg-[#301B69] text-white border-[#301B69] shadow-lg'
                : 'bg-white/80 border-[#301B69]/10',
            ]}>
              {plan.highlight && (
                <p class="text-xs font-semibold text-white/60 uppercase tracking-widest mb-2">Most Popular</p>
              )}
              <h3 class:list={['font-semibold text-lg mb-1', plan.highlight ? 'text-white' : 'text-[#301B69]']}>
                {plan.name}
              </h3>
              <p class:list={['text-2xl font-bold mb-1', plan.highlight ? 'text-white' : 'text-[#301B69]']}>
                {plan.price}
              </p>
              <p class:list={['text-sm', plan.highlight ? 'text-white/70' : 'text-[#301B69]/60']}>
                {plan.desc}
              </p>
            </li>
          ))}
        </ul>

        <a
          href="/pricing"
          class="inline-flex items-center gap-2 px-6 py-3 bg-[#301B69] text-white rounded-xl font-medium hover:opacity-90 transition-opacity"
        >
          View pricing →
        </a>
      </div>
    </div>
  </div>
</section>
