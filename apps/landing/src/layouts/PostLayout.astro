---
import BlogLayout from './BlogLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, date, updatedAt, author, authorRole, excerpt, tags, readTime, image } = post.data;

const siteURL = 'https://agenvik.com';
const slug = post.id.replace(/\.mdx?$/, '');
const postURL = `${siteURL}/blog/${slug}`;
const dateISO = new Date(date).toISOString();
const modifiedISO = updatedAt ? new Date(updatedAt).toISOString() : dateISO;
const imageURL = image ? `${siteURL}${image}` : `${siteURL}/og-image.png`;

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': postURL,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postURL },
  headline: title,
  description: excerpt,
  image: {
    '@type': 'ImageObject',
    url: imageURL,
    width: image ? 1600 : 1200,
    height: image ? 840 : 630,
  },
  author: {
    '@type': 'Person',
    name: author,
    ...(authorRole ? { jobTitle: authorRole } : {}),
  },
  publisher: { '@id': `${siteURL}/#organization` },
  datePublished: dateISO,
  dateModified: modifiedISO,
  keywords: tags,
  articleSection: tags[0] ?? 'Blog',
  inLanguage: 'en-US',
  url: postURL,
};

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const TAG_COLORS = [
  'bg-[#301B69]/10 text-[#301B69]',
  'bg-[#B07CD1]/15 text-[#6B3FA0]',
  'bg-purple-50 text-purple-700',
];
---

<BlogLayout
  title={`${title} — Agenvik Blog`}
  description={excerpt}
  ogImage={image ?? '/og-image.png'}
  ogImageWidth={image ? '1600' : '1200'}
  ogImageHeight={image ? '840' : '630'}
  ogType="article"
  jsonLd={blogPostingSchema}
  articlePublishedTime={dateISO}
  articleModifiedTime={modifiedISO}
  articleAuthor={author}
  articleTags={tags}
  articleSection={tags[0] ?? 'Blog'}
>
  <!-- Breadcrumb -->
  <div class="max-w-4xl mx-auto px-6 pt-8">
    <Breadcrumb items={[{ label: 'Blog', href: '/blog' }, { label: title }]} />
  </div>

  <!-- Post card -->
  <article class="max-w-4xl mx-auto px-6 py-8 pb-16">
    <div class="bg-white rounded-3xl border border-[#301B69]/10 shadow-sm p-10 md:p-14">

      <!-- Post header -->
      <header class="mb-10">
        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mb-4">
          {tags.map((tag, i) => (
            <span class={`text-xs px-2.5 py-0.5 rounded-full font-medium ${TAG_COLORS[i % TAG_COLORS.length]}`}>
              {tag}
            </span>
          ))}
        </div>

        <h1 class="text-3xl md:text-4xl font-bold text-[#301B69] mb-4 leading-tight">
          {title}
        </h1>
        <p class="text-[#301B69]/70 leading-relaxed mb-6">{excerpt}</p>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-[#301B69]/50 border-t border-[#301B69]/10 pt-4">
          <span class="font-medium text-[#301B69]/70">{author}</span>
          {authorRole && <span>· {authorRole}</span>}
          <span class="flex items-center gap-1.5">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            {formatDate(date)}
          </span>
          <span class="flex items-center gap-1.5">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {readTime}
          </span>
        </div>
      </header>

      <!-- Cover image -->
      {image && (
        <div class="mb-10 -mx-10 md:-mx-14 overflow-hidden">
          <img
            src={image}
            alt={title}
            class="w-full max-h-[480px] object-cover"
            loading="eager"
            decoding="async"
          />
        </div>
      )}

      <!-- MDX content -->
      <div class="blog-prose">
        <slot />
      </div>

      <!-- End-of-post CTA -->
      <div class="mt-14 pt-8 border-t border-[#301B69]/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <p class="font-semibold text-[#301B69] mb-1">Ready to build your AI agent?</p>
          <p class="text-sm text-[#301B69]/60">Start free — no credit card required.</p>
        </div>
        <a
          href="https://app.agenvik.com"
          data-get-started
          data-source="post_cta"
          class="bg-[#301B69] text-white px-5 py-2.5 rounded-xl text-sm shadow hover:opacity-90 transition whitespace-nowrap"
        >
          Get Started →
        </a>
      </div>
    </div>

    <!-- Back link bottom -->
    <div class="mt-8 text-center">
      <a href="/blog" class="text-sm text-[#301B69]/70 hover:text-[#301B69] transition inline-flex items-center gap-1.5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Back to all posts
      </a>
    </div>
  </article>
</BlogLayout>
