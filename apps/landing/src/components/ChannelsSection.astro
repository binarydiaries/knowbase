---
import { getImage } from 'astro:assets';
import howBgSrc from '../assets/images/how-bg.png';
import { Monitor, MessageCircle, Hash } from '@lucide/astro';

const howBg = await getImage({ src: howBgSrc, format: 'webp', quality: 80 });
---
<section id="channels" aria-labelledby="channels-heading" class="px-6 pt-16">
  <div class="max-w-6xl mx-auto">
    <div
      class="relative rounded-3xl p-10 md:p-14 bg-cover bg-center overflow-hidden"
      style={`background-image: url(${howBg.src})`}
    >
      <div class="absolute inset-0 bg-white/50 backdrop-blur-[2px]" aria-hidden="true"></div>
      <div class="absolute -bottom-20 right-0 w-[400px] h-[300px] bg-[#B07CD1]/20 blur-[100px]" aria-hidden="true"></div>

      <div class="relative z-10">
        <div class="inline-flex items-center px-4 py-1 text-xs rounded-full bg-white/70 backdrop-blur text-[#301B69] mb-4" aria-hidden="true">
          ✦ CHANNELS
        </div>
        <h2 id="channels-heading" class="text-3xl md:text-4xl font-bold text-[#301B69] mb-10">
          One agent. Meet your customers where they are.
        </h2>

        <div class="grid md:grid-cols-3 gap-6">

          <!-- Website Chat Widget -->
          <div class="rounded-2xl border border-[#301B69]/10 bg-white shadow-sm overflow-hidden flex flex-col">
            <div class="p-6 pb-4">
              <div class="w-9 h-9 rounded-xl bg-[#301B69]/8 flex items-center justify-center text-[#301B69] mb-4" aria-hidden="true">
                <Monitor size={18} strokeWidth={1.75} />
              </div>
              <h3 class="font-semibold text-[#301B69] text-lg mb-2">Embed on any website with one line of code</h3>
              <p class="text-sm text-[#301B69]/70 leading-relaxed mb-4">Copy the snippet from your dashboard. Paste it before <code class="text-[#301B69]/80 bg-[#301B69]/5 px-1 rounded">&lt;/body&gt;</code> on any webpage. Works on Webflow, Shopify, WordPress, Squarespace, or any custom site.</p>
              <div class="space-y-1 text-xs text-[#301B69]/60">
                <p class="font-medium text-[#301B69]/80 text-xs mb-1">Customise today:</p>
                <p>· Agent name &amp; avatar in widget header</p>
                <p>· Greeting message</p>
                <p>· Widget position (left or right)</p>
              </div>
            </div>
            <div class="mx-5 mb-5 mt-auto rounded-xl border border-[#301B69]/10 overflow-hidden shadow-sm">
              <div class="bg-[#301B69] px-3 py-2.5 flex items-center gap-2">
                <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
                  <svg class="w-3 h-3 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                </div>
                <div>
                  <p class="text-[10px] text-white font-medium leading-none">Aria</p>
                  <p class="text-[8px] text-white/60 mt-0.5">Online now</p>
                </div>
              </div>
              <div class="bg-white p-3 space-y-2">
                <div class="bg-[#301B69]/5 rounded-lg px-3 py-2 max-w-[85%]">
                  <p class="text-[10px] text-[#301B69]/80">Hi! How can I help you today?</p>
                </div>
                <div class="bg-[#301B69] rounded-lg px-3 py-2 max-w-[85%] ml-auto">
                  <p class="text-[10px] text-white">Do you ship internationally?</p>
                </div>
                <div class="bg-[#301B69]/5 rounded-lg px-3 py-2 max-w-[90%]">
                  <p class="text-[10px] text-[#301B69]/80">Yes! We ship to 50+ countries. Standard delivery takes 7–14 days…</p>
                </div>
              </div>
            </div>
          </div>

          <!-- WhatsApp -->
          <div class="rounded-2xl border border-[#301B69]/10 bg-white shadow-sm overflow-hidden flex flex-col">
            <div class="p-6 pb-4">
              <div class="w-9 h-9 rounded-xl bg-[#25D366]/10 flex items-center justify-center text-[#25D366] mb-4" aria-hidden="true">
                <MessageCircle size={18} strokeWidth={1.75} />
              </div>
              <h3 class="font-semibold text-[#301B69] text-lg mb-2">Your agent handles WhatsApp messages automatically</h3>
              <p class="text-sm text-[#301B69]/70 leading-relaxed mb-4">Connect your WhatsApp Business number in 15 minutes. Every incoming message goes through your agent — instant, accurate replies at any hour without your team being online.</p>
              <p class="text-xs text-[#301B69]/50 bg-[#301B69]/5 rounded-lg px-3 py-2">
                <span class="font-medium text-[#301B69]/70">Requires:</span> WhatsApp Business account + dedicated phone number
              </p>
            </div>
            <div class="mx-5 mb-5 mt-auto rounded-xl overflow-hidden border border-[#25D366]/20">
              <div class="bg-[#075E54] px-3 py-2.5 flex items-center gap-2">
                <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0 text-[10px] text-white font-bold">A</div>
                <div>
                  <p class="text-[10px] text-white font-medium leading-none">Aria · Your Business</p>
                  <p class="text-[8px] text-white/60 mt-0.5">WhatsApp Business</p>
                </div>
              </div>
              <div class="bg-[#e5ddd5] p-3 space-y-2">
                <div class="bg-white rounded-lg px-3 py-1.5 inline-block max-w-[85%] shadow-sm">
                  <p class="text-[10px] text-gray-700">What are your store hours?</p>
                </div>
                <div class="ml-auto bg-[#dcf8c6] rounded-lg px-3 py-1.5 max-w-[90%] shadow-sm">
                  <p class="text-[10px] text-[#075E54]">We're open Mon–Sat, 10am–8pm IST. You can also shop online 24/7.</p>
                  <p class="text-[8px] text-[#075E54]/50 mt-0.5">Source: Store Info</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Slack -->
          <div class="rounded-2xl border border-[#301B69]/10 bg-white shadow-sm overflow-hidden flex flex-col">
            <div class="p-6 pb-4">
              <div class="w-9 h-9 rounded-xl bg-[#4A154B]/10 flex items-center justify-center text-[#4A154B] mb-4" aria-hidden="true">
                <Hash size={18} strokeWidth={1.75} />
              </div>
              <h3 class="font-semibold text-[#301B69] text-lg mb-2">Internal knowledge, available in any Slack channel</h3>
              <p class="text-sm text-[#301B69]/70 leading-relaxed">Install the Agenvik Slack bot and deploy your internal knowledge agent into any workspace channel. Team members ask questions in natural language — the agent answers from your internal docs, SOPs, or onboarding materials.</p>
            </div>
            <div class="mx-5 mb-5 mt-auto bg-[#1a1d21] rounded-xl overflow-hidden border border-white/5">
              <div class="px-3 py-2 border-b border-white/10">
                <p class="text-[9px] text-white/40"># new-hires</p>
              </div>
              <div class="p-3 space-y-3">
                <div class="flex items-start gap-2">
                  <div class="w-6 h-6 rounded bg-blue-600 flex items-center justify-center flex-shrink-0 text-[9px] font-bold text-white">J</div>
                  <div>
                    <p class="text-[9px] text-white/60 font-medium mb-0.5">Jamie</p>
                    <p class="text-[10px] text-white/80">How do I request time off?</p>
                  </div>
                </div>
                <div class="flex items-start gap-2">
                  <div class="w-6 h-6 rounded bg-[#4A154B] flex items-center justify-center flex-shrink-0 text-[9px] font-bold text-white">A</div>
                  <div>
                    <p class="text-[9px] text-white/60 font-medium mb-0.5">Aria <span class="text-white/30 font-normal bg-white/10 px-1 rounded text-[8px]">APP</span></p>
                    <p class="text-[10px] text-white/80">Submit a leave request via HR portal. Approval takes 1–2 business days…</p>
                    <p class="text-[8px] text-white/30 mt-0.5">Source: Leave Policy 2026.pdf</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>
