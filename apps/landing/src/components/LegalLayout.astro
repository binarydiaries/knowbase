---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description: string;
  lastUpdated: string;   // ISO date string e.g. '2026-04-21'
  pageURL: string;       // full canonical URL e.g. 'https://agenvik.com/privacy-policy'
}

const { title, description, lastUpdated, pageURL } = Astro.props;

const siteURL = 'https://agenvik.com';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageURL,
  url: pageURL,
  name: `${title} — Agenvik`,
  description,
  isPartOf: { '@id': `${siteURL}/#website` },
  about: { '@id': `${siteURL}/#organization` },
  publisher: { '@id': `${siteURL}/#organization` },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['#page-description'],
  },
  dateModified: lastUpdated,
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
      { '@type': 'ListItem', position: 2, name: title, item: pageURL },
    ],
  },
};
---

<Layout
  title={`${title} — Agenvik`}
  description={description}
  jsonLd={webPageSchema}
>
  <main id="main-content" class="relative w-full bg-white pt-[68px]">

    <!-- Grid background (fades out quickly — just frames the top) -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background-image: linear-gradient(rgba(48,27,105,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(48,27,105,0.07) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, white 0%, white 18%, transparent 35%); -webkit-mask-image: linear-gradient(to bottom, white 0%, white 18%, transparent 35%);"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_70%_40%_at_50%_0%,rgba(124,58,237,0.07),transparent)] pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 pt-10 pb-16">
      <div class="bg-white rounded-3xl border border-[#301B69]/10 shadow-sm p-10 md:p-14">
        <slot />
      </div>
    </div>
  </main>
  <Footer />
</Layout>
