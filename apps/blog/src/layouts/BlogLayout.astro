---
import '../styles/global.css'

interface Props {
  title: string
  description: string
  ogTitle?: string
  ogDescription?: string
  ogType?: string
  canonicalUrl?: string
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogType = 'website',
  canonicalUrl,
} = Astro.props

const base = import.meta.env.BASE_URL
const resolvedCanonical = canonicalUrl ?? Astro.url.href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:site_name" content="Agenvik Blog" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@agenvik" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/TextLogo.svg" />
  </head>

  <body class="bg-[#f8f7fc] min-h-screen flex flex-col">
    <!-- Sticky header -->
    <header class="px-6 py-4 border-b border-[#301B69]/10 bg-white/80 backdrop-blur sticky top-0 z-50">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <a href="https://agenvik.com" aria-label="Agenvik home">
          <img src="/TextLogo.svg" alt="Agenvik" class="h-7 w-auto" />
        </a>

        <nav aria-label="Blog navigation" class="hidden md:flex gap-6 text-sm text-[#301B69]/70">
          <a href="https://agenvik.com/#features" class="hover:text-[#301B69] transition">Features</a>
          <a href="https://agenvik.com/#pricing" class="hover:text-[#301B69] transition">Pricing</a>
          <a href="https://agenvik.com/#faq" class="hover:text-[#301B69] transition">FAQ</a>
          <a href={base} class="text-[#301B69] font-medium transition">Blog</a>
        </nav>

        <a
          href="https://app.agenvik.com"
          class="bg-[#301B69] text-white px-4 py-2 rounded-lg text-sm hover:opacity-90 transition"
        >
          Get Started
        </a>
      </div>
    </header>

    <!-- Page content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="px-6 py-10 mt-16 border-t border-[#301B69]/10 bg-white/60">
      <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-3 gap-8 mb-8">
          <div>
            <a href="https://agenvik.com" aria-label="Agenvik home">
              <img src="/TextLogo.svg" alt="Agenvik" class="h-7 w-auto mb-3" />
            </a>
            <p class="text-sm text-[#301B69]/60 leading-relaxed max-w-xs">
              Build powerful AI agents from your knowledge. No coding required.
            </p>
          </div>

          <nav aria-label="Quick links">
            <h2 class="text-sm font-semibold text-[#301B69] mb-3">Quick Links</h2>
            <ul class="space-y-2 text-sm text-[#301B69]/70 list-none">
              <li><a href="https://agenvik.com" class="hover:text-[#301B69] transition">Home</a></li>
              <li><a href="https://agenvik.com/#features" class="hover:text-[#301B69] transition">Features</a></li>
              <li><a href="https://agenvik.com/#pricing" class="hover:text-[#301B69] transition">Pricing</a></li>
              <li><a href={base} class="hover:text-[#301B69] transition">Blog</a></li>
            </ul>
          </nav>

          <nav aria-label="Resources links">
            <h2 class="text-sm font-semibold text-[#301B69] mb-3">Resources</h2>
            <ul class="space-y-2 text-sm text-[#301B69]/70 list-none">
              <li><a href="https://agenvik.com/docs" class="hover:text-[#301B69] transition">Documentation</a></li>
              <li><a href="https://agenvik.com/docs/help-and-support/overview" class="hover:text-[#301B69] transition">Help & Support</a></li>
              <li><a href="https://agenvik.com/privacy-policy" class="hover:text-[#301B69] transition">Privacy Policy</a></li>
              <li><a href="https://agenvik.com/terms" class="hover:text-[#301B69] transition">Terms & Conditions</a></li>
            </ul>
          </nav>
        </div>

        <div class="border-t border-[#301B69]/10 pt-6">
          <p class="text-center text-sm text-[#301B69]/50">
            © {new Date().getFullYear()} Agenvik. All rights reserved.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
